<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Easy4K.ProgressPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:Easy4K"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Page.Resources>
        <ResourceDictionary>
            <!-- 主题画笔（CardBgBrush/CardBorderBrush）与玻璃样式已上移至 App.xaml -->

            <Style x:Key="CardBorder" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource CardBgBrush}"/>
                <Setter Property="BorderBrush" Value="{ThemeResource CardBorderBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CornerRadius" Value="8"/>
                <Setter Property="Padding" Value="12"/>
            </Style>
        </ResourceDictionary>
    </Page.Resources>

    <Grid Padding="16" RowSpacing="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>      <!-- 降级横幅 -->
            <RowDefinition Height="Auto"/>      <!-- 顶部进度条 -->
            <RowDefinition Height="*"/>         <!-- 预览图占满剩余 -->
            <RowDefinition Height="280"/>       <!-- 底部固定280px -->
        </Grid.RowDefinitions>

        <!-- 降级横幅（安全帧率降级时显示） -->
        <Border Grid.Row="0" x:Name="DegradeBanner" CornerRadius="6" Background="#40FF6600" Padding="10,6" Margin="0,0,0,4"
                Visibility="{x:Bind Vm.IsDegraded, Mode=OneWay}">
            <TextBlock Text="{x:Bind Vm.DegradeNotice, Mode=OneWay}" FontWeight="SemiBold" FontSize="12" Foreground="#FFFF8800"/>
        </Border>

        <!-- 顶部：总进度 -->
        <StackPanel Grid.Row="1" Spacing="6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{x:Bind Vm.ProgressDetail, Mode=OneWay}" FontSize="16" FontWeight="SemiBold"/>
                <TextBlock Grid.Column="2" Text="{x:Bind Vm.ProgressText, Mode=OneWay}" FontSize="16" FontWeight="Bold" HorizontalAlignment="Right"/>
            </Grid>
            <ProgressBar Value="{x:Bind Vm.ProgressPercent, Mode=OneWay}" Maximum="100" Height="18"/>
        </StackPanel>

        <!-- 预览图（占满剩余空间） -->
        <Border Grid.Row="2" Style="{StaticResource CardBorder}">
            <Grid RowSpacing="4">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <ToggleSwitch Grid.Row="0" Header="图片预览" IsOn="{x:Bind Vm.ShowPreview, Mode=TwoWay}" IsEnabled="{x:Bind Vm.IsPreviewToggleEnabled, Mode=OneWay}" FontSize="12"/>
                <Grid Grid.Row="1">
                    <TextBlock x:Name="PreviewHint" Text="{x:Bind Vm.PreviewHintText, Mode=OneWay}" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.4" FontSize="14"/>
                    <Image x:Name="PreviewImage" Stretch="Uniform" Visibility="{x:Bind Vm.ShowPreview, Mode=OneWay}"/>
                </Grid>
            </Grid>
        </Border>

        <!-- 下区：CMD 日志 + CPU/GPU -->
        <Grid Grid.Row="3" ColumnSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- 下左：CMD 命令输出 -->
            <Border Grid.Column="0" Style="{StaticResource CardBorder}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="命令输出" FontWeight="SemiBold" FontSize="13"/>
                        <Button Grid.Column="1" Content="复制日志" Click="OnCopyLog" FontSize="11" Margin="0,0,8,0" Style="{StaticResource GlassButton}"/>
                        <Button Grid.Column="2" Content="清空" Click="OnClearLog" FontSize="11" Style="{StaticResource GlassButton}"/>
                    </Grid>
                    <TextBox x:Name="CommandLogBox" Grid.Row="1" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap"
                             FontFamily="Consolas" FontSize="11" Background="Transparent" BorderThickness="0"
                             ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Disabled"/>
                </Grid>
            </Border>

            <!-- 下右：CPU / GPU 圆形进度条 -->
            <Border Grid.Column="1" Style="{StaticResource CardBorder}">
                <StackPanel Spacing="8" MinWidth="110" VerticalAlignment="Center">
                    <StackPanel Spacing="2">
                        <TextBlock Text="CPU" HorizontalAlignment="Center" FontWeight="SemiBold" FontSize="12"/>
                        <Grid Width="64" Height="64" HorizontalAlignment="Center">
                            <ProgressRing x:Name="CpuRing" Width="64" Height="64" IsIndeterminate="False" Minimum="0" Maximum="100" Value="{x:Bind Vm.CpuUsage, Mode=OneWay}" Foreground="#FF4CAF50"/>
                            <TextBlock Text="{x:Bind Vm.CpuUsageText, Mode=OneWay}" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold" FontSize="14"/>
                        </Grid>
                    </StackPanel>
                    <StackPanel Spacing="2">
                        <TextBlock Text="GPU" HorizontalAlignment="Center" FontWeight="SemiBold" FontSize="12"/>
                        <Grid Width="64" Height="64" HorizontalAlignment="Center">
                            <ProgressRing x:Name="GpuRing" Width="64" Height="64" IsIndeterminate="False" Minimum="0" Maximum="100" Value="{x:Bind Vm.GpuUsage, Mode=OneWay}" Foreground="#FF2196F3"/>
                            <TextBlock Text="{x:Bind Vm.GpuUsageText, Mode=OneWay}" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold" FontSize="14"/>
                        </Grid>
                    </StackPanel>
                    <Button Content="停止" Click="OnStop" IsEnabled="{x:Bind Vm.CanStop, Mode=OneWay}" HorizontalAlignment="Stretch" Style="{StaticResource GlassButton}"/>
                    <Button x:Name="PauseBtn" Content="暂停" Click="OnPauseToggle" FontSize="12"
                            IsEnabled="{x:Bind Vm.IsProcessing, Mode=OneWay}" HorizontalAlignment="Stretch" Style="{StaticResource GlassButton}"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Page>
