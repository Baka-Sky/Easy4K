<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>Easy4K</RootNamespace>
    <!-- 软件版本号：与 Package.appxmanifest 的 Identity Version、appsettings.json 的 Version 保持一致 -->
    <Version>2.1.2</Version>
    <FileVersion>2.1.2.0</FileVersion>
    <AssemblyVersion>2.1.2.0</AssemblyVersion>
    <ApplicationIcon>Assets\AppIcon.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x64</Platforms>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">win-$([System.Runtime.InteropServices.RuntimeInformation]::ProcessArchitecture.ToString().ToLowerInvariant())</RuntimeIdentifier>
    <UseWinUI>true</UseWinUI>
    <EnableMsixTooling>false</EnableMsixTooling>
    <!-- Unpackaged: simpler file/process access for a dev tool -->
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <NoWarn>CA1416;CA1851;CS8602;CS8604</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.4.0" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.28000.2526" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
    <PackageReference Include="MySqlConnector" Version="2.6.2" />
    <PackageReference Include="System.Management" Version="9.0.0" />
    <PackageReference Include="System.Diagnostics.PerformanceCounter" Version="9.0.0" />
    <!-- SFDP 帧去重 AI 判决：直接跑 ONNX 孪生网络，优先 DirectML，显卡不支持时自动回退 CPU -->
    <PackageReference Include="Microsoft.ML.OnnxRuntime.DirectML" Version="1.24.4" />
  </ItemGroup>

  <ItemGroup>
    <!-- 帧去重（SFDP）：算法独立成一个可被外部调用的命令行工具，主程序直接引用同一份源码，
         不再有第二份实现（两边行为永远一致）。 -->
    <ProjectReference Include="..\Easy4K.SFDP\Easy4K.SFDP.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Manifest Include="$(ApplicationManifest)" />
  </ItemGroup>

  <!-- App settings: copy to output dir on build -->
  <ItemGroup>
    <None Include="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <!-- 多语言文案表：随程序分发，用户可自行修改/补充语言 -->
    <None Include="Loc\strings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <!-- 欢迎向导素材：logo / 欢迎音乐复制到输出目录（exe 旁），便于首次引导展示 -->
  <ItemGroup>
    <None Include="..\..\logo.png" Link="Assets\logo.png" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\logo.png" Link="Res\logo.png" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\welcomemusic.wav" Link="Res\welcomemusic.wav" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- Tool binaries are copied alongside the exe at publish time. During dev (unpackaged),
       Tools sit at I:\Easy4K\Tools and are resolved by ToolPathResolver at runtime. -->
  <ItemGroup>
    <!-- Assets 全量跟到输出目录：卡片插图(XAML 用 ms-appx:///Assets/...)、窗口图标 AppIcon.ico、
         以及 MSIX manifest 引用的各尺寸图标(StoreLogo 50 / Square44x44 44+88 / Square150x150 150+300 /
         Wide310x150 310x150+620x300 / SplashScreen 620x300+1240x600 / targetsize 24·48)。
         图标文件名与尺寸遵循 MSIX 资源规范(基名=scale-100, .scale-200 为 200% 变体)，MSIX 打包以输出目录为准。 -->
    <!-- Fonts 由下面的 Content 项单独处理，这里先移除默认的 None 项，避免同一文件被两种 Item 重复复制 -->
    <None Remove="Assets\Fonts\*.ttf" />
    <None Update="Assets\**">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </None>
  </ItemGroup>

  <!-- 内嵌字体：HarmonyOS Sans SC（Regular / Medium / Bold，简体中文全字库）。随包分发，不依赖系统安装，
       XAML 里用 ms-appx:///Assets/Fonts/HarmonyOS_Sans_SC_Regular.ttf#HarmonyOS Sans SC 直接引用。 -->
  <ItemGroup>
    <Content Include="Assets\Fonts\*.ttf">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

  <!-- 随包声明文档（安装声明 / 系统要求 / 入门指南）：跟到输出目录，发行版开箱自带 -->
  <ItemGroup>
    <None Include="..\..\声明\*.txt" Link="声明\%(Filename)%(Extension)">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <!-- 构建后自动把项目根 Tools（FFmpeg/NVEncC/realesrgan/rife/AudioSR/便携python）增量同步到输出目录，
       保证 Debug/Release/publish 产物自包含可运行。robocopy 退出码 0-7 均为成功，>=8 才报错。
       注意：排除列表里不能带 bin —— FFmpeg-Lei\bin 是必需的原生组件目录。 -->
  <Target Name="CopyToolsToOutput" AfterTargets="Build">
    <Exec IgnoreExitCode="true" Command="robocopy &quot;$(MSBuildThisFileDirectory)..\..\Tools&quot; &quot;$(OutDir)Tools&quot; /E /NFL /NDL /NJH /NJS /NP /XD .git obj __pycache__ &amp; if %25ERRORLEVEL% GEQ 8 exit /b 1" />
  </Target>

  <!-- 孤儿任务调度守护进程：单独一个无界面控制台 exe（Easy4K.Orphan.exe）。
       构建主程序时一并构建并复制到输出目录，保证 Debug/Release/publish 产物依旧是自包含的一份，
       不需要额外的构建步骤；孤儿模式在没有这个 exe 时会明确提示而不是静默失败。 -->
  <Target Name="BuildOrphanDaemon" AfterTargets="Build" Condition="Exists('$(MSBuildThisFileDirectory)..\Easy4K.Orphan\Easy4K.Orphan.csproj')">
    <MSBuild Projects="$(MSBuildThisFileDirectory)..\Easy4K.Orphan\Easy4K.Orphan.csproj"
             Targets="Build"
             Properties="Configuration=$(Configuration);Platform=$(Platform)">
      <Output TaskParameter="TargetOutputs" ItemName="OrphanDaemonAssembly" />
    </MSBuild>
    <!-- TargetOutputs 只给到主程序集（.dll），apphost / runtimeconfig / deps 在同目录，单独补上 -->
    <ItemGroup>
      <OrphanDaemonFile Include="@(OrphanDaemonAssembly)" />
      <OrphanDaemonFile Include="@(OrphanDaemonAssembly->'%(RootDir)%(Directory)Easy4K.Orphan.exe')" />
      <OrphanDaemonFile Include="@(OrphanDaemonAssembly->'%(RootDir)%(Directory)Easy4K.Orphan.runtimeconfig.json')" />
      <OrphanDaemonFile Include="@(OrphanDaemonAssembly->'%(RootDir)%(Directory)Easy4K.Orphan.deps.json')" />
    </ItemGroup>
    <Copy SourceFiles="@(OrphanDaemonFile)" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" Condition="Exists('%(OrphanDaemonFile.FullPath)')" />
  </Target>

  <!-- 只保留 zh-CN/zh-TW 语言资源，删除 WindowsAppSDK 生成的其他语言目录（xx-XX 命名） -->
  <Target Name="TrimLanguages" AfterTargets="Build">
    <Exec IgnoreExitCode="true" Command="powershell -NoProfile -ExecutionPolicy Bypass -Command &quot;Get-ChildItem -LiteralPath '$(OutDir)' -Directory | Where-Object { $_.Name -match '^[a-z]{2,3}-' -and $_.Name -notin @('zh-CN','zh-TW') } | ForEach-Object { Remove-Item -LiteralPath $_.FullName -Recurse -Force }&quot;" />
  </Target>

</Project>
