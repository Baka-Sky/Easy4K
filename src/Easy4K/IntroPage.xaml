<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Easy4K.IntroPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Easy4K.Controls">

    <Grid Padding="16,0,16,16" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="12" Margin="0,8,0,0">
            <Button x:Name="PlayButton" Content="▶  播放入场" Click="OnPlay" Style="{StaticResource GlassButton}"/>
            <TextBlock VerticalAlignment="Center" FontSize="12" Opacity="0.6"
                       Text="从纵深飞入 → Logo 砸落 → 震屏 + 白闪 + 冲击波；鼠标在画面上移动可倾斜 / 放大卡片。"/>
        </StackPanel>

        <Grid Grid.Row="1">
            <controls:IntroHero x:Name="Hero" Height="440" VerticalAlignment="Center"/>
        </Grid>
    </Grid>
</Page>
