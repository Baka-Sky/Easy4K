<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="Easy4K.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Easy4K">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
                <!-- Other merged dictionaries here -->
            </ResourceDictionary.MergedDictionaries>

            <!-- 全局主题画笔：卡片/控件用半透明纯色，任何环境都能稳定透出背景 -->
            <!-- 显式固定圆角资源：ComboBox 弹出层(Popup)默认用 OverlayCornerRadius，某些 WinUI 版本/主题会解析成直角，
                 这里强制 8px(弹出层)/4px(控件)，保证所有下拉框弹出都是圆角（OverlayCornerRadius 必须定义在 App 级才生效） -->
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <CornerRadius x:Key="OverlayCornerRadius">8,8,8,8</CornerRadius>
                    <CornerRadius x:Key="ControlCornerRadius">4,4,4,4</CornerRadius>
                    <!-- 卡片底色必须不透明：半透明底色会让卡片内的文字整层走灰度抗锯齿，
                         细笔画的英文模型名看着发虚（ClearType 要求不透明底色）。 -->
                    <SolidColorBrush x:Key="CardBgBrush" Color="#FFFFFFFF"/>
                    <SolidColorBrush x:Key="ButtonBgBrush" Color="#8CF5F5F5"/>
                    <SolidColorBrush x:Key="CardBorderBrush" Color="#FFC8C8C8"/>
                    <SolidColorBrush x:Key="WarnBgBrush" Color="#20FFB300"/>
                    <!-- 占位文字用不透明灰：系统默认的半透明占位色会让文字走灰度抗锯齿，看起来发虚 -->
                    <SolidColorBrush x:Key="InputPlaceholderBrush" Color="#FF6E6E6E"/>
                    <!-- 下拉框正文用不透明色：WinUI 默认的 TextFillColorPrimaryBrush 带 89% alpha，
                         半透明文字同样拿不到 ClearType，细笔画的英文模型名会发虚 -->
                    <SolidColorBrush x:Key="ComboTextBrush" Color="#FF1B1B1B"/>
                    <!-- 字族必须写进主题字典：WinUI 的内置样式用 {ThemeResource ContentControlThemeFontFamily} 取，
                         而 ThemeResource 优先查主题字典，只在普通资源里覆盖对控件不生效。 -->
                    <FontFamily x:Key="ContentControlThemeFontFamily">ms-appx:///Assets/Fonts/HarmonyOS_Sans_SC_Regular.ttf#HarmonyOS Sans SC</FontFamily>
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <CornerRadius x:Key="OverlayCornerRadius">8,8,8,8</CornerRadius>
                    <CornerRadius x:Key="ControlCornerRadius">4,4,4,4</CornerRadius>
                    <SolidColorBrush x:Key="CardBgBrush" Color="#FF2B2B2B"/>
                    <SolidColorBrush x:Key="ButtonBgBrush" Color="#8C2A2A2A"/>
                    <SolidColorBrush x:Key="CardBorderBrush" Color="#FF444444"/>
                    <SolidColorBrush x:Key="WarnBgBrush" Color="#30FFB300"/>
                    <SolidColorBrush x:Key="InputPlaceholderBrush" Color="#FFA8A8A8"/>
                    <SolidColorBrush x:Key="ComboTextBrush" Color="#FFF2F2F2"/>
                    <FontFamily x:Key="ContentControlThemeFontFamily">ms-appx:///Assets/Fonts/HarmonyOS_Sans_SC_Regular.ttf#HarmonyOS Sans SC</FontFamily>
                </ResourceDictionary>
                <ResourceDictionary x:Key="HighContrast">
                    <CornerRadius x:Key="OverlayCornerRadius">8,8,8,8</CornerRadius>
                    <CornerRadius x:Key="ControlCornerRadius">4,4,4,4</CornerRadius>
                    <SolidColorBrush x:Key="CardBgBrush" Color="{ThemeResource SystemColorWindowColor}"/>
                    <SolidColorBrush x:Key="ButtonBgBrush" Color="{ThemeResource SystemColorWindowColor}"/>
                    <SolidColorBrush x:Key="CardBorderBrush" Color="{ThemeResource SystemColorWindowTextColor}"/>
                    <SolidColorBrush x:Key="WarnBgBrush" Color="{ThemeResource SystemColorWindowColor}"/>
                    <SolidColorBrush x:Key="InputPlaceholderBrush" Color="{ThemeResource SystemColorWindowTextColor}"/>
                    <SolidColorBrush x:Key="ComboTextBrush" Color="{ThemeResource SystemColorWindowTextColor}"/>
                    <FontFamily x:Key="ContentControlThemeFontFamily">ms-appx:///Assets/Fonts/HarmonyOS_Sans_SC_Regular.ttf#HarmonyOS Sans SC</FontFamily>
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>

            <!-- ===== 内嵌字体 HarmonyOS Sans SC（简体中文全字库）=====
                 字体文件随包放在 Assets\Fonts，XAML 用 ms-appx + "#家族名" 直接引用，
                 不需要用户在系统里安装；家族名必须与 TTF 内的实际家族名一致（Regular/Bold 同为
                 "HarmonyOS Sans SC"，Medium 是独立家族 "HarmonyOS Sans SC Medium"）。
                 注意：这些直接在资源字典里的项必须写在 ThemeDictionaries 之后，
                 写在它之前会把字典当成隐式 _Items 赋值，XAML 编译器直接报 WMC0035。 -->
            <FontFamily x:Key="AppFontFamily">ms-appx:///Assets/Fonts/HarmonyOS_Sans_SC_Regular.ttf#HarmonyOS Sans SC</FontFamily>
            <FontFamily x:Key="AppFontMediumFamily">ms-appx:///Assets/Fonts/HarmonyOS_Sans_SC_Medium.ttf#HarmonyOS Sans SC Medium</FontFamily>
            <FontFamily x:Key="AppFontBoldFamily">ms-appx:///Assets/Fonts/HarmonyOS_Sans_SC_Bold.ttf#HarmonyOS Sans SC</FontFamily>

            <!-- 覆盖 WinUI 的默认字族：Button / TextBox / ComboBox 等所有控件，
                 以及 TitleTextBlockStyle、CaptionTextBlockStyle 这类内置文本样式都从这里取字族 -->
            <FontFamily x:Key="ContentControlThemeFontFamily">ms-appx:///Assets/Fonts/HarmonyOS_Sans_SC_Regular.ttf#HarmonyOS Sans SC</FontFamily>

            <!-- 全局控件亚克力样式：ALL IN，按钮/输入框全部玻璃化 -->
            <Style x:Key="GlassButton" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
                <Setter Property="Background" Value="{ThemeResource ButtonBgBrush}"/>
                <Setter Property="BorderBrush" Value="{ThemeResource CardBorderBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}"/>
            </Style>
            <Style x:Key="GlassTextBox" TargetType="TextBox">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderBrush" Value="{ThemeResource CardBorderBrush}"/>
                <Setter Property="CornerRadius" Value="4"/>
                <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}"/>
                <Setter Property="PlaceholderForeground" Value="{ThemeResource InputPlaceholderBrush}"/>
            </Style>
            <Style x:Key="GlassComboBox" TargetType="ComboBox" BasedOn="{StaticResource DefaultComboBoxStyle}">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderBrush" Value="{ThemeResource CardBorderBrush}"/>
                <Setter Property="CornerRadius" Value="4"/>
                <!-- 下拉框里的中文（算法名/种类名）笔画比英文模型名密，Regular 小字看着发虚；
                     Medium 笔画更实，与模型名（纯英文）观感一致 -->
                <Setter Property="FontFamily" Value="{StaticResource AppFontMediumFamily}"/>
                <Setter Property="PlaceholderForeground" Value="{ThemeResource InputPlaceholderBrush}"/>
                <Setter Property="Foreground" Value="{ThemeResource ComboTextBrush}"/>
            </Style>
            <Style x:Key="GlassNumberBox" TargetType="NumberBox">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderBrush" Value="{ThemeResource CardBorderBrush}"/>
                <Setter Property="CornerRadius" Value="4"/>
                <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}"/>
            </Style>

            <!-- 兜底：没有显式 Style 的普通 TextBlock 也走内嵌字体（有显式 Style 的由样式/主题字典负责） -->
            <Style TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}"/>
            </Style>

            <!-- 所有下拉框（含没写 Style 的）统一玻璃样式 + 内嵌字体 + TextBlock 项模板 -->
            <Style TargetType="ComboBox" BasedOn="{StaticResource GlassComboBox}"/>
            <Style TargetType="ComboBoxItem" BasedOn="{StaticResource DefaultComboBoxItemStyle}">
                <Setter Property="FontFamily" Value="{StaticResource AppFontMediumFamily}"/>
                <Setter Property="Foreground" Value="{ThemeResource ComboTextBrush}"/>
            </Style>

            <!-- 弹出层控件：ToolTip 也是模板 + ContentPresenter 自绘文本，
                 不指定字体就会用系统字族（中文回退后观感与界面其它文字不一致） -->
            <Style TargetType="ToolTip">
                <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}"/>
                <Setter Property="FontSize" Value="13"/>
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
