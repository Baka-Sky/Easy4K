<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Easy4K.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Page.Resources>
        <ResourceDictionary>
            <Style x:Key="CardBorder" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource CardBgBrush}"/>
                <Setter Property="BorderBrush" Value="{ThemeResource CardBorderBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CornerRadius" Value="8"/>
                <Setter Property="Padding" Value="16"/>
            </Style>
            <Style x:Key="SectionTitle" TargetType="TextBlock">
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="Margin" Value="0,0,0,8"/>
            </Style>
            <Style x:Key="FieldLabel" TargetType="TextBlock">
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="MinWidth" Value="80"/>
                <Setter Property="FontFamily" Value="Segoe UI Medium"/>
                <Setter Property="Margin" Value="0,0,8,0"/>
            </Style>
        </ResourceDictionary>
    </Page.Resources>

    <Grid Padding="16,0,16,16">
        <ScrollViewer Padding="0,8,0,0" VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="10">

                <TextBlock Text="设置" FontSize="20" FontWeight="Bold" Margin="0,2,0,4"/>

                <!-- 外观 -->
                <Border Style="{StaticResource CardBorder}">
                    <StackPanel Spacing="6">
                        <TextBlock Text="外观" Style="{StaticResource SectionTitle}"/>
                        <RadioButton x:Name="ThemeLightRb" Content="浅色主题" GroupName="Theme" Checked="OnThemeChanged"/>
                        <RadioButton x:Name="ThemeDarkRb" Content="深色主题" GroupName="Theme" Checked="OnThemeChanged"/>
                        <RadioButton x:Name="ThemeSystemRb" Content="跟随系统" GroupName="Theme" Checked="OnThemeChanged"/>
                        <RadioButton x:Name="ThemeAcrylicRb" Content="亚克力" GroupName="Theme" Checked="OnThemeChanged"/>
                        <RadioButton x:Name="ThemeImageRb" Content="图片背景（背景图 + 亚克力覆盖）" GroupName="Theme" Checked="OnThemeChanged"/>

                        <!-- 选中"图片背景"后才出现（排版同主页的目录选择：80 / * / Auto） -->
                        <Grid x:Name="BgImageRow" ColumnSpacing="8" Visibility="Collapsed" Margin="28,0,0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="背景图片" Style="{StaticResource FieldLabel}"/>
                            <TextBox  Grid.Column="1" Text="{x:Bind Vm.BackgroundImage, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      PlaceholderText="选择或输入 .jpg/.png/.webp/.bmp 图片路径" Style="{StaticResource GlassTextBox}"/>
                            <Button   Grid.Column="2" Content="浏览" Click="OnBrowseBgImage" Style="{StaticResource GlassButton}"/>
                        </Grid>

                        <!-- 覆盖层浓度：0% 几乎只见图片，100% 几乎纯色（文字最清晰） -->
                        <Grid x:Name="BgOpacityRow" ColumnSpacing="8" Visibility="Collapsed" Margin="28,0,0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="亚克力浓度" Style="{StaticResource FieldLabel}"/>
                            <Slider   Grid.Column="1" Minimum="0" Maximum="100" StepFrequency="5" TickFrequency="10"
                                      Value="{x:Bind Vm.BackdropAcrylicPercent, Mode=TwoWay}" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="2" Text="{x:Bind Vm.BackdropOpacityText, Mode=OneWay}"
                                       MinWidth="40" TextAlignment="Right" VerticalAlignment="Center" FontSize="12"/>
                        </Grid>

                        <TextBlock x:Name="BgImageHint" FontSize="10" Opacity="0.6" TextWrapping="Wrap" Margin="28,0,0,0" Visibility="Collapsed"
                                   Text="整窗铺满该图片，上面覆盖一层亚克力（模糊 + 深色着色），界面固定用深色主题保证卡片与文字可读；浓度越高越糊越暗、文字越清晰。换图/拖动立即生效，随配置一起保存。"/>
                    </StackPanel>
                </Border>

                <!-- 文件与目录 -->
                <Border Style="{StaticResource CardBorder}">
                    <StackPanel Spacing="6">
                        <TextBlock Text="文件与目录" Style="{StaticResource SectionTitle}"/>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Content="打开视频" Click="OnOpenVideo" Style="{StaticResource GlassButton}"/>
                            <Button Content="选择临时目录..." Click="OnChooseTemp" Style="{StaticResource GlassButton}"/>
                            <Button Content="选择输出目录..." Click="OnChooseOutput" Style="{StaticResource GlassButton}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- 工具与诊断 -->
                <Border Style="{StaticResource CardBorder}">
                    <StackPanel Spacing="6">
                        <TextBlock Text="工具与诊断" Style="{StaticResource SectionTitle}"/>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Content="检查环境" Click="OnCheckEnv" Style="{StaticResource GlassButton}"/>
                            <Button Content="检查显卡" Click="OnCheckGpu" Style="{StaticResource GlassButton}"/>
                            <Button Content="清理临时文件" Click="OnCleanTemp" IsEnabled="{x:Bind Vm.CanClean, Mode=OneWay}" Style="{StaticResource GlassButton}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- 默认值 / 帮助 / 退出 -->
                <Border Style="{StaticResource CardBorder}">
                    <StackPanel Spacing="6">
                        <TextBlock Text="其它" Style="{StaticResource SectionTitle}"/>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Content="保存当前设置为默认" Click="OnSaveDefaults" Style="{StaticResource GlassButton}"/>
                            <Button Content="使用说明 (F1)" Click="OnHelp" Style="{StaticResource GlassButton}"/>
                            <Button Content="快捷键" Click="OnShortcuts" Style="{StaticResource GlassButton}"/>
                            <Button Content="关于 Easy4K" Click="OnAbout" Style="{StaticResource GlassButton}"/>
                            <Button Content="退出 (Alt+F4)" Click="OnExit" Style="{StaticResource GlassButton}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
