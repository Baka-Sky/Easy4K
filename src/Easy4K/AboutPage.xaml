<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Easy4K.AboutPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Page.Resources>
        <ResourceDictionary>
            <Style x:Key="CardBorder" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource CardBgBrush}"/>
                <Setter Property="BorderBrush" Value="{ThemeResource CardBorderBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CornerRadius" Value="8"/>
                <Setter Property="Padding" Value="16"/>
            </Style>
        </ResourceDictionary>
    </Page.Resources>

    <Grid Padding="16,0,16,16">
        <ScrollViewer Padding="0,8,0,0" VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="10">

                <StackPanel Orientation="Horizontal" Spacing="10">
                    <Button Content="← 返回设置" Click="OnBack" Style="{StaticResource GlassButton}"/>
                    <TextBlock Text="关于" FontSize="20" FontWeight="Bold" VerticalAlignment="Center"/>
                </StackPanel>

                <Border Style="{StaticResource CardBorder}">
                    <Grid ColumnSpacing="24">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Spacing="6" VerticalAlignment="Center">
                            <TextBlock Text="Easy4K" FontSize="30" FontWeight="Bold"/>
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <TextBlock Text="版本" FontSize="15"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                <TextBlock Text="{x:Bind Version}" FontSize="15"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            </StackPanel>
                            <TextBlock Text="一键视频超分与补帧工具" FontSize="14" Margin="0,4,0,0"/>
                        </StackPanel>

                        <!-- 主题适配的黑白 logo 保持由 AboutPage.xaml.cs 加载 -->
                        <Image x:Name="AboutLogo" Grid.Column="1"
                               Width="180" Stretch="Uniform"
                               Margin="0,0,7,0"
                               HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>
                </Border>

                <Border Style="{StaticResource CardBorder}">
                    <StackPanel Spacing="8">
                        <TextBlock Text="项目说明" FontSize="16" FontWeight="SemiBold"/>
                        <TextBlock x:Name="AboutTextBlock" FontSize="13" TextWrapping="Wrap"
                                   LineHeight="18" LineStackingStrategy="BlockLineHeight"
                                   IsTextSelectionEnabled="True"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardBorder}">
                    <StackPanel Spacing="8">
                        <TextBlock Text="版权与许可" FontSize="16" FontWeight="SemiBold"/>
                        <TextBlock x:Name="CopyrightTextBlock" FontSize="13" TextWrapping="Wrap"
                                   IsTextSelectionEnabled="True"/>
                        <StackPanel Spacing="4">
                            <HyperlinkButton Content="项目主页：github.com/Baka-Sky/Easy4K"
                                             NavigateUri="https://github.com/Baka-Sky/Easy4K"
                                             HorizontalAlignment="Left" Padding="0"/>
                            <HyperlinkButton Content="模型主页：huggingface.co/Sudabaka/SFDP-Siamese-NET-AI"
                                             NavigateUri="https://huggingface.co/Sudabaka/SFDP-Siamese-NET-AI"
                                             HorizontalAlignment="Left" Padding="0"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- 赞助：文字在左（垂直居中），二维码在右 -->
                <Border Style="{StaticResource CardBorder}">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Spacing="8" VerticalAlignment="Center">
                            <TextBlock Text="赞助" FontSize="14" FontWeight="SemiBold"/>
                            <TextBlock FontSize="13" TextWrapping="Wrap"
                                       Text="如果您觉得项目不错，您可以考虑赞助我；我会将资金投入服务器费用及宣发费用中。"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                            <Image x:Name="SponsorQr1" Height="200" Stretch="Uniform"/>
                            <Image x:Name="SponsorQr2" Height="200" Stretch="Uniform"/>
                        </StackPanel>
                    </Grid>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
