<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Easy4K.AboutPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Page.Resources>
        <ResourceDictionary>
            <Style x:Key="CardBorder" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource CardBgBrush}"/>
                <Setter Property="BorderBrush" Value="{ThemeResource CardBorderBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CornerRadius" Value="8"/>
                <Setter Property="Padding" Value="16"/>
            </Style>
        </ResourceDictionary>
    </Page.Resources>

    <Grid Padding="16,0,16,16">
        <ScrollViewer Padding="0,8,0,0" VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="10">

                <StackPanel Orientation="Horizontal" Spacing="10">
                    <Button Content="← 返回设置" Click="OnBack" Style="{StaticResource GlassButton}"/>
                    <TextBlock Text="关于" FontSize="20" FontWeight="Bold" VerticalAlignment="Center"/>
                </StackPanel>

                <Border Style="{StaticResource CardBorder}">
                    <StackPanel Spacing="8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                <TextBlock Text="Easy4K" FontSize="24" FontWeight="Bold"/>
                                <TextBlock Text="{x:Bind Version}" FontSize="24" FontWeight="Bold" VerticalAlignment="Bottom"/>
                            </StackPanel>

                            <!-- 右上角 logo：浅色主题用黑版、深色主题用白版（主题变化时换图）。
                                 负右边距把图片再往卡片右缘推一点（抵消卡片内边距） -->
                            <Image x:Name="AboutLogo" Grid.Column="1"
                                   Width="180" Stretch="Uniform"
                                   Margin="0,0,-28,0"
                                   HorizontalAlignment="Right" VerticalAlignment="Top"/>
                        </Grid>

                        <!-- 版本、组件、附加能力、免责声明：与旧「关于」弹窗同一份文本。
                             行高按字号收紧，否则内嵌字体自带的 ascent/descent 会留下很大的行距 -->
                        <TextBlock x:Name="AboutTextBlock" FontSize="13" TextWrapping="Wrap"
                                   LineHeight="18" LineStackingStrategy="BlockLineHeight"
                                   IsTextSelectionEnabled="True"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    </StackPanel>
                </Border>

                <!-- 赞助：文字在左（垂直居中），二维码在右 -->
                <Border Style="{StaticResource CardBorder}">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Spacing="8" VerticalAlignment="Center">
                            <TextBlock Text="赞助" FontSize="14" FontWeight="SemiBold"/>
                            <TextBlock FontSize="13" TextWrapping="Wrap"
                                       Text="如果您觉得项目不错，您可以考虑赞助我；我会将资金投入服务器费用及宣发费用中。"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                            <Image x:Name="SponsorQr1" Height="200" Stretch="Uniform"/>
                            <Image x:Name="SponsorQr2" Height="200" Stretch="Uniform"/>
                        </StackPanel>
                    </Grid>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
