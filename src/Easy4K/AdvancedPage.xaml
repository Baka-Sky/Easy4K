<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Easy4K.AdvancedPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Page.Resources>
        <ResourceDictionary>
            <!-- 与主界面保持一致的卡片样式 -->
            <Style x:Key="CardBorder" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource CardBgBrush}"/>
                <Setter Property="BorderBrush" Value="{ThemeResource CardBorderBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CornerRadius" Value="8"/>
                <Setter Property="Padding" Value="16"/>
            </Style>
            <Style x:Key="SectionTitle" TargetType="TextBlock">
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="Margin" Value="0,0,0,8"/>
            </Style>
            <Style x:Key="FieldLabel" TargetType="TextBlock">
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="MinWidth" Value="80"/>
                <Setter Property="FontFamily" Value="{StaticResource AppFontMediumFamily}"/>
                <Setter Property="Margin" Value="0,0,8,0"/>
            </Style>
        </ResourceDictionary>
    </Page.Resources>

    <Grid Padding="16,0,16,16">
        <ScrollViewer Padding="0,8,0,0" VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="10">

                <TextBlock Text="高级" FontSize="20" FontWeight="Bold" Margin="0,2,0,4"/>

                <!-- 帧去重：超分/补帧前剔除重复帧，省计算量（合并前按索引表回填，时长与音频不变） -->
                <Border Style="{StaticResource CardBorder}">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="6">
                            <Grid ColumnSpacing="6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="帧去重" Style="{StaticResource SectionTitle}" Margin="0"/>
                            <Button Grid.Column="1" HorizontalAlignment="Left"
                                    Padding="3" Background="Transparent" BorderThickness="0"
                                    VerticalAlignment="Center" Click="OnDedupInfoClick"
                                    ToolTipService.ToolTip="性能模式：FP16 半精度 AI 模型，速度快、误删更少&#x0a;完美模式：FP32 单精度 AI 模型，判得更细，更吃算力&#x0a;&#x0a;点击图标查看详细讲解"
                                    AutomationProperties.Name="帧去重说明">
                                <FontIcon Glyph="&#xE946;" FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            </Button>
                        </Grid>

                        <ToggleSwitch x:Name="DedupSwitch" OnContent="已开启" OffContent="已关闭"
                                      IsOn="{x:Bind Vm.DedupEnabled, Mode=TwoWay}" FontSize="12"/>

                        <TextBlock TextWrapping="Wrap" FontSize="11" Opacity="0.6"
                                   Text="用 AI 孪生网络判断相邻两帧是不是同一画面：重复帧不进超分/补帧，处理完按索引表原样补回，成品时长、帧率与音频都不变。重复帧越多省得越多（动画「一拍二/三」通常可省 30%~50% 的超分/补帧耗时）。"/>

                        <RadioButton x:Name="DedupPerfRb" Content="Performance Mode 性能模式" GroupName="DedupMode"
                                     Checked="OnDedupModeChecked" FontSize="12"/>
                        <RadioButton x:Name="DedupUhdRb" Content="UHD Mode 完美模式" GroupName="DedupMode"
                                     Checked="OnDedupModeChecked" FontSize="12"/>
                        <TextBlock x:Name="DedupHint" FontSize="11" Opacity="0.6" TextWrapping="Wrap"/>
                        </StackPanel>

                        <!-- 卡片右下角插图（随主题切换：浅色用黑版、深色用白版；源码见 AdvancedPage.xaml.cs）。
                             Width/Height 必须写死：插图的列是 Auto，图片尺寸一变会挤着左边的小字重新折行。
                             4K 原图按显示尺寸解码由代码里的 DecodePixelWidth 负责。 -->
                        <Image x:Name="DedupArt" Grid.Column="1"
                               Width="150" Height="84" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                               Visibility="Collapsed" AutomationProperties.Name="帧去重插图"/>
                    </Grid>
                </Border>

                <!-- 音频超分：把音轨交给 AudioSR 升到 48kHz 高带宽；开启后音频不再走 ffmpeg 重采样 -->
                <Border Style="{StaticResource CardBorder}">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="6">
                            <Grid ColumnSpacing="6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="音频超分" Style="{StaticResource SectionTitle}" Margin="0"/>
                                <Button Grid.Column="1" HorizontalAlignment="Left"
                                        Padding="3" Background="Transparent" BorderThickness="0"
                                        VerticalAlignment="Center" Click="OnAudioSrInfoClick"
                                        ToolTipService.ToolTip="FP16 低精度性能模式：仅 GPU，速度更快（比 FP32 快约 10%~20%）&#x0a;FP32 高精度完美模式：CPU/GPU 均可，画质基准&#x0a;&#x0a;点击图标查看详细讲解"
                                        AutomationProperties.Name="音频超分说明">
                                    <FontIcon Glyph="&#xE946;" FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                </Button>
                            </Grid>

                            <ToggleSwitch x:Name="AudioSrSwitch" OnContent="已开启" OffContent="已关闭"
                                          IsOn="{x:Bind Vm.AudioSrEnabled, Mode=TwoWay}" FontSize="12"/>

                            <TextBlock TextWrapping="Wrap" FontSize="11" Opacity="0.6"
                                       Text="开启后音频不再由 ffmpeg 重采样，改由 AudioSR 升采样到 48kHz 高带宽。勾选主页「将原音频合并进新视频」时替换视频音轨（时长与帧率不变）；未勾选则不动视频，单独输出一份 48kHz WAV。输入视频必须有音频流才生效。"/>

                            <RadioButton x:Name="AudioSrFp16Rb" Content="FP16 低精度性能模式" GroupName="AudioSrPrecision"
                                         Checked="OnAudioSrPrecisionChecked" FontSize="12"/>
                            <RadioButton x:Name="AudioSrFp32Rb" Content="FP32 高精度完美模式" GroupName="AudioSrPrecision"
                                         Checked="OnAudioSrPrecisionChecked" FontSize="12"/>
                            <TextBlock x:Name="AudioSrHint" FontSize="11" Opacity="0.6" TextWrapping="Wrap"/>
                        </StackPanel>

                        <!-- 卡片右下角插图（随主题切换：浅色用黑版、深色用白版；源码见 AdvancedPage.xaml.cs）。
                             Width/Height 必须写死：插图的列是 Auto，图片尺寸一变会挤着左边的小字重新折行。
                             4K 原图按显示尺寸解码由代码里的 DecodePixelWidth 负责。 -->
                        <Image x:Name="AudioSrArt" Grid.Column="1"
                               Width="150" Height="84" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                               Visibility="Collapsed" AutomationProperties.Name="音频超分插图"/>
                    </Grid>
                </Border>

                <!-- 涡轮模式：把 CPU 侧（拆帧/去重判决/回填）与 GPU 侧（超分/补帧）按块同时开工，音频链路再独立并行 -->
                <Border Style="{StaticResource CardBorder}">
                    <StackPanel Spacing="6">
                        <Grid ColumnSpacing="6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="涡轮模式" Style="{StaticResource SectionTitle}" Margin="0"/>
                            <Button Grid.Column="1" HorizontalAlignment="Left"
                                    Padding="3" Background="Transparent" BorderThickness="0"
                                    VerticalAlignment="Center" Click="OnTurboInfoClick"
                                    ToolTipService.ToolTip="把视频按帧号切成 1~5 段，每段各自跑一条完整流水线并行处理&#x0a;全部完成后按原顺序汇总帧，再统一做音频 / 合并 / HDR / 审查&#x0a;&#x0a;点击图标查看详细讲解"
                                    AutomationProperties.Name="涡轮模式说明">
                                <FontIcon Glyph="&#xE946;" FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            </Button>
                        </Grid>

                        <ToggleSwitch x:Name="TurboSwitch" OnContent="已开启" OffContent="已关闭"
                                      IsOn="{x:Bind Vm.TurboMode, Mode=TwoWay}" Toggled="OnTurboToggled" FontSize="12"/>

                        <TextBlock TextWrapping="Wrap" FontSize="11" Opacity="0.6"
                                   Text="把视频按帧号切成若干段，每段各自跑一条完整流水线并行处理，全部完成后按顺序汇总帧再统一合并。由于数据吞吐巨大，本功能要求临时目录必须为固态存储介质。"/>

                        <!-- 分段数：只在涡轮模式开启时出现（1 = 不分段） -->
                        <StackPanel x:Name="TurboBlockPanel" Spacing="4"
                                    Visibility="{x:Bind Vm.TurboSegmentsVis, Mode=OneWay}">
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Slider Grid.Column="0" Minimum="1" Maximum="5" StepFrequency="1" TickFrequency="1"
                                        Value="{x:Bind Vm.TurboSegments, Mode=TwoWay}"
                                        HorizontalAlignment="Stretch" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="{x:Bind Vm.TurboSegmentsLabel, Mode=OneWay}"
                                           VerticalAlignment="Center" FontSize="12" MinWidth="70" TextAlignment="Right"/>
                            </Grid>
                            <TextBlock Text="涡轮分段（默认 2 段，最大 5 段）：段数越多越吃 CPU / 显存带宽；1 段等于不分段。"
                                       FontSize="11" Opacity="0.6" TextWrapping="Wrap"/>
                        </StackPanel>

                        <TextBlock x:Name="TurboHint" FontSize="11" Opacity="0.6" TextWrapping="Wrap"
                                   Text="段与段之间互不重叠：每段按帧号精确切分，处理完按原顺序汇总，成片时长与帧率不变；开启涡轮期间处理线程固定 1:1:1。"/>
                    </StackPanel>
                </Border>

                <!-- 报告：HTML 报告保存目录（排版同主页的临时目录选择） -->
                <Border Style="{StaticResource CardBorder}">
                    <StackPanel Spacing="6">
                        <TextBlock Text="报告" Style="{StaticResource SectionTitle}"/>
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="报告目录" Style="{StaticResource FieldLabel}"/>
                            <TextBox  Grid.Column="1" Text="{x:Bind Vm.ReportDir, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="HTML 报告文件保存目录" Style="{StaticResource GlassTextBox}"/>
                            <Button   Grid.Column="2" Content="浏览" Click="OnBrowseReportDir" Style="{StaticResource GlassButton}"/>
                        </Grid>
                        <TextBlock Text="处理完成后生成的 HTML 报告（选项/命令/抽帧）保存在这里；可填绝对路径，留空按 Reports。" FontSize="11" Opacity="0.6" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <!-- 电源：启动时阻止 Windows 自动休眠 -->
                <Border Style="{StaticResource CardBorder}">
                    <StackPanel Spacing="6">
                        <TextBlock Text="电源" Style="{StaticResource SectionTitle}"/>
                        <CheckBox x:Name="PreventSleepCb" FontSize="12"
                                  Content="启动时禁止 Windows 自动休眠（长时间处理不会被系统睡眠打断）"
                                  IsChecked="{x:Bind Vm.PreventAutoSleep, Mode=TwoWay}"/>
                        <TextBlock FontSize="11" Opacity="0.6" TextWrapping="Wrap"
                                   Text="开启后 Easy4K 运行期间会持续向系统申请唤醒。只阻止系统休眠，不阻止关闭显示器或自动锁屏；关闭开关或退出程序后立即恢复系统默认电源策略。"/>
                    </StackPanel>
                </Border>

                <!-- 高级性能选项（原主界面同名区块整体移入） -->
                <Border Style="{StaticResource CardBorder}" BorderBrush="Orange" Background="{ThemeResource WarnBgBrush}">
                    <StackPanel Spacing="2">
                        <TextBlock Text="高级性能选项" Style="{StaticResource SectionTitle}"/>
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Slider Grid.Column="0" Minimum="1" Maximum="32" StepFrequency="1" TickFrequency="1"
                                    Value="{x:Bind Vm.ThreadCount, Mode=TwoWay}"
                                    IsEnabled="{x:Bind Vm.ThreadsEditable, Mode=OneWay}"
                                    ValueChanged="OnThreadSliderValueChanged"
                                    HorizontalAlignment="Stretch" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="{x:Bind Vm.ThreadLabel, Mode=OneWay}"
                                       VerticalAlignment="Center" FontSize="12" MinWidth="70" TextAlignment="Right"/>
                        </Grid>
                        <TextBlock Text="{x:Bind Vm.ThreadHintText, Mode=OneWay}"
                                   FontSize="11" Opacity="0.6" TextWrapping="Wrap"/>
                        <TextBlock Text="{x:Bind Vm.ThreadWarnText, Mode=OneWay}" Foreground="Orange"
                                   FontSize="11" TextWrapping="Wrap" Visibility="{x:Bind Vm.ThreadWarnVis, Mode=OneWay}"/>

                        <!-- 编码质量：CPU 编码的 CRF、硬件编码的 CQ/QP（互斥，编码器由显卡自动选择） -->
                        <Grid ColumnSpacing="8" Margin="0,6,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="CPU CRF" VerticalAlignment="Center" FontSize="12" FontFamily="{StaticResource AppFontMediumFamily}"/>
                            <NumberBox Grid.Column="1" Value="{x:Bind Vm.Crf, Mode=TwoWay}" Minimum="0" Maximum="51" SmallChange="1"
                                       SpinButtonPlacementMode="Compact" Width="120"/>
                            <TextBlock Grid.Column="2" Text="数值越小越不压缩：画质更好，但成片体积更大（0~51，默认 18）"
                                       VerticalAlignment="Center" FontSize="11" Opacity="0.6" TextWrapping="Wrap"/>
                        </Grid>
                        <CheckBox x:Name="HwCqCb" FontSize="12"
                                  Content="硬件编码 CQ（恒定质量模式：硬件按画面复杂度动态调整量化参数，画质更稳定）"
                                  IsChecked="{x:Bind Vm.HwCqEnabled, Mode=TwoWay}"/>
                        <CheckBox x:Name="HwQpCb" FontSize="12"
                                  Content="硬件编码 QP（固定量化参数：直接指定压缩力度）"
                                  IsChecked="{x:Bind Vm.HwQpEnabled, Mode=TwoWay}"/>
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="HwQualityLabel" Grid.Column="0" Text="CQ / QP 值" VerticalAlignment="Center" FontSize="12" FontFamily="{StaticResource AppFontMediumFamily}"/>
                            <NumberBox x:Name="HwQualityBox" Grid.Column="1" Value="{x:Bind Vm.HwQuality, Mode=TwoWay}" Minimum="0" Maximum="51" SmallChange="1"
                                       SpinButtonPlacementMode="Compact" Width="120"/>
                            <TextBlock x:Name="HwQualityHint" Grid.Column="2" Text="取值范围 0~51，数值越小画质越好、码率越高；未勾选 CQ/QP 时用默认档。两者互斥：开一个另一个自动关闭。仅硬件编码生效（编码器由显卡自动选择：N 卡 NVENC / A 卡 AMF），CPU 处理模式下不可用。"
                                       VerticalAlignment="Center" FontSize="11" Opacity="0.6" TextWrapping="Wrap"/>
                        </Grid>
                        <CheckBox x:Name="SkipStartupSelfTestCb" Content="跳过测试（每次点开始处理不再先用 1 秒测试视频验证勾选流程，直接处理）"
                                  IsChecked="{x:Bind Vm.SkipStartupSelfTest, Mode=TwoWay}" FontSize="12"/>
                        <CheckBox x:Name="SafeFrameRateCb" Content="开启安全帧率 (NCNN 遇到设备丢失/显存/内存溢出时强制停止)" IsChecked="{x:Bind Vm.UseSafeFrameRate, Mode=TwoWay}" FontSize="12"/>
                        <CheckBox x:Name="LowerQualityCb" Content="降低部分画质以降低显存/内存占用 (NCNN: -u UHD 模式；PyTorch 轨补帧: FP16 半精度，不支持时自动回退；可与安全帧率共存)" IsChecked="{x:Bind Vm.LowerQualityForVram, Mode=TwoWay}" FontSize="12"/>
                        <CheckBox x:Name="GpuAccelerationCb" Content="{x:Bind Vm.GpuAccelerationLabel, Mode=OneWay}" IsChecked="{x:Bind Vm.UseGpuAcceleration, Mode=TwoWay}" FontSize="12"/>
                        <CheckBox x:Name="CpuProcessingCb" Content="使用CPU处理所有模型 (超分/补帧 NCNN -g -1；注意：超分无 CPU 后端会自动升级为 GPU、SDR→HDR 固定用 NVIDIA GPU；速度很慢，仅在 GPU 不可用/不稳定时建议开启)"
                                  Checked="OnUseCpuProcessingChecked"
                                  Unchecked="OnUseCpuProcessingUnchecked"
                                  FontSize="12"/>
                        <CheckBox x:Name="NoReportCb" Content="不生成配置文件（处理完成后不再生成 HTML 报告文件）"
                                  IsChecked="{x:Bind Vm.NoReport, Mode=TwoWay}" FontSize="12"/>
                        <CheckBox x:Name="ReportAutoOpenCb" Content="报告生成后自动用浏览器打开（关掉后报告照常生成，但不再弹浏览器）"
                                  IsChecked="{x:Bind Vm.ReportAutoOpen, Mode=TwoWay}" FontSize="12"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardBorder}">
                    <StackPanel Spacing="4">
                        <TextBlock Text="关于高级模式" Style="{StaticResource SectionTitle}"/>
                        <TextBlock TextWrapping="Wrap" FontSize="11" Opacity="0.7"
                                   Text="标准模式下这些选项不显示；此处的改动会立即写入 appsettings.json，下次启动保持。切回标准模式点上方「标准模式」即可。"/>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
