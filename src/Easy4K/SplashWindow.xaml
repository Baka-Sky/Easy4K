<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="Easy4K.SplashWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <!-- 启动画面：整窗铺启动图（100% 比例、圆角由 DWM 裁切），
         底部半透明状态条显示检测进度 -->
    <Grid x:Name="Root">
        <Image x:Name="SplashImage" Stretch="UniformToFill"/>

        <Border VerticalAlignment="Bottom" Padding="20,12" Background="#99000000">
            <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                <ProgressRing IsActive="True" Width="18" Height="18" Foreground="White"/>
                <TextBlock x:Name="StatusText" Text="正在检查必要组件…"
                           Foreground="White" FontSize="13" VerticalAlignment="Center"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
