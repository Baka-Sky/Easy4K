<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="Easy4K.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:Easy4K"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="Easy4K"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 标题栏 -->
        <Grid x:Name="AppTitleBar" Grid.Row="0" Height="40" Padding="12,0,8,0">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="8">
                <Image Source="Assets/AppIcon.ico" Width="18" Height="18"/>
                <TextBlock Text="Easy4K" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center"/>
            </StackPanel>
        </Grid>

        <!-- 顶栏：菜单栏 + 主页/进行中导航按钮（与"帮助"平齐） -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <MenuBar Grid.Column="0">
                <MenuBarItem Title="文件">
                    <MenuFlyoutItem Text="打开视频 (Ctrl+O)" Click="OnOpenVideoMenu"/>
                    <MenuFlyoutItem Text="选择临时目录..." Click="OnChooseTempMenu"/>
                    <MenuFlyoutItem Text="选择输出目录..." Click="OnChooseOutputMenu"/>
                    <MenuFlyoutSeparator/>
                    <MenuFlyoutItem Text="退出 (Alt+F4)" Click="OnExitMenu"/>
                </MenuBarItem>
                <MenuBarItem Title="工具">
                    <MenuFlyoutItem Text="检查环境" Click="OnCheckEnvMenu"/>
                    <MenuFlyoutItem Text="检查显卡" Click="OnCheckGpuMenu"/>
                    <MenuFlyoutSeparator/>
                    <MenuFlyoutItem Text="清理临时文件" Click="OnCleanTempMenu"/>
                </MenuBarItem>
                <MenuBarItem Title="设置">
                    <MenuFlyoutItem Text="浅色主题" Click="OnThemeLight"/>
                    <MenuFlyoutItem Text="深色主题" Click="OnThemeDark"/>
                    <MenuFlyoutItem Text="跟随系统" Click="OnThemeSystem"/>
                    <MenuFlyoutSeparator/>
                    <MenuFlyoutItem Text="保存当前设置为默认" Click="OnSaveSettingsMenu"/>
                </MenuBarItem>
                <MenuBarItem Title="帮助">
                    <MenuFlyoutItem Text="使用说明 (F1)" Click="OnHelpMenu"/>
                    <MenuFlyoutItem Text="快捷键" Click="OnShortcutsMenu"/>
                    <MenuFlyoutSeparator/>
                    <MenuFlyoutItem Text="关于 Easy4K" Click="OnAboutMenu"/>
                </MenuBarItem>
            </MenuBar>

            <StackPanel x:Name="NavButtons" Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center" Margin="0,0,8,0" Visibility="Collapsed">
                <Button x:Name="HomeNavBtn" Content="主页" Click="OnNavHome" FontSize="12" Padding="12,4"/>
                <Button x:Name="ProgressNavBtn" Content="进行中" Click="OnNavProgress" FontSize="12" Padding="12,4"/>
            </StackPanel>
        </Grid>

        <!-- 纯进度条（贴缝，进行页自动隐藏） -->
        <ProgressBar x:Name="ThinProgressBar" Grid.Row="2" Height="3" Minimum="0" Maximum="100" Value="0"/>

        <Frame x:Name="RootFrame" Grid.Row="3"/>
    </Grid>
</Window>
