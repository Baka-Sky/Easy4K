<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="Easy4K.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:Easy4K"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="Easy4K"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 图片背景主题：整窗铺满背景图（含标题栏区域），上覆一层应用内亚克力（模糊+着色）。
             默认隐藏，仅 theme=image 时由 ApplyBackdropImage 打开；未选图时只剩亚克力遮罩，
             底下仍是系统亚克力 backdrop，不会出现"空背景"。 -->
        <Image x:Name="BackdropImage" Grid.Row="0" Grid.RowSpan="2"
               Stretch="UniformToFill" HorizontalAlignment="Center" VerticalAlignment="Center"
               Visibility="Collapsed" IsHitTestVisible="False"/>
        <Border x:Name="BackdropOverlay" Grid.Row="0" Grid.RowSpan="2"
                Visibility="Collapsed" IsHitTestVisible="False">
            <Border.Background>
                <AcrylicBrush TintColor="#1C1C1C" TintOpacity="0.45" FallbackColor="#991C1C1C"/>
            </Border.Background>
        </Border>

        <!-- 标题栏 -->
        <Grid x:Name="AppTitleBar" Grid.Row="0" Height="40" Padding="12,0,8,0">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="8">
                <Image Source="Assets/AppIcon.ico" Width="18" Height="18"/>
                <TextBlock x:Name="TitleTextBlock" Text="Easy4K" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center"/>
            </StackPanel>
        </Grid>

        <!-- 自适应导航：宽窗口用顶栏（Top），窄窗口收成左侧最小化（LeftMinimal）。
             导航项：主页 / 高级 / 进行中（仅处理期间出现）；最右侧齿轮进入设置页。 -->
        <NavigationView x:Name="RootNav" Grid.Row="1"
                        PaneDisplayMode="Top"
                        IsSettingsVisible="True"
                        IsBackButtonVisible="Collapsed"
                        IsPaneToggleButtonVisible="True"
                        IsTitleBarAutoPaddingEnabled="False"
                        SelectionFollowsFocus="Disabled"
                        SelectionChanged="OnRootNavSelectionChanged"
                        ItemInvoked="OnRootNavItemInvoked">
            <NavigationView.MenuItems>
                <NavigationViewItem Content="主页" Tag="ez"/>
                <NavigationViewItem Content="高级" Tag="adv"/>
                <!-- 进行中：仅处理期间出现 -->
                <NavigationViewItem x:Name="ProgressNavItem" Content="进行中" Tag="progress" Visibility="Collapsed"/>
            </NavigationView.MenuItems>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- 纯进度条（贴缝，未启动时隐藏，进行页自动隐藏） -->
                <ProgressBar x:Name="ThinProgressBar" Grid.Row="0" Height="3" Minimum="0" Maximum="100" Value="0"
                             VerticalAlignment="Top" Visibility="Collapsed"/>

                <!-- 遥控另一台 Easy4K 时：进度条下面拉一条黄色横幅，提示当前连的是哪台机器 -->
                <Border x:Name="RemoteBanner" Grid.Row="1" Visibility="Collapsed"
                        Background="{ThemeResource SystemFillColorCautionBackgroundBrush}"
                        BorderBrush="{ThemeResource SystemFillColorCautionBrush}" BorderThickness="0,0,0,1"
                        Padding="12,6">
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <FontIcon Grid.Column="0" Glyph="&#xE7BA;" FontSize="14" VerticalAlignment="Center"
                                  Foreground="{ThemeResource SystemFillColorCautionBrush}"/>
                        <TextBlock x:Name="RemoteBannerText" Grid.Column="1" VerticalAlignment="Center"
                                   FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                        <Button Grid.Column="2" Content="断开" Click="OnRemoteBannerDisconnect"
                                Style="{StaticResource GlassButton}"/>
                    </Grid>
                </Border>

                <Frame x:Name="RootFrame" Grid.Row="2"/>
            </Grid>
        </NavigationView>

        <!-- 非目标式通知条（TeachingTip 不设 Target → 显示在窗口底部居中，不遮挡内容）。
             用于"点了有动作、但界面上看不到反馈"的按钮：提取音频 / 保存默认设置 / 复制日志 / 清除输入等。
             标题、正文、动作按钮由 MainWindow.ShowNotice 动态指定，点击动作按钮回到触发页面继续操作。 -->
        <TeachingTip x:Name="NoticeTip" Grid.Row="0" Grid.RowSpan="2"
                     IsOpen="False"
                     PreferredPlacement="Bottom"
                     IsLightDismissEnabled="True"
                     CloseButtonContent="知道了"
                     ActionButtonClick="OnNoticeTipAction"
                     Closed="OnNoticeTipClosed"/>

        <!-- 远程控制模式：整窗盖住所有界面，只留中间的等待/已连接提示。
             由设置页「远程控制 → 启动」打开；结束远程控制后收起。 -->
        <Grid x:Name="RemoteOverlay" Grid.Row="0" Grid.RowSpan="2" Visibility="Collapsed"
              Background="{ThemeResource SolidBackgroundFillColorBaseBrush}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="16" MaxWidth="560">
                <ProgressRing x:Name="RemoteRing" IsActive="True" Width="72" Height="72"
                              HorizontalAlignment="Center"/>
                <TextBlock x:Name="RemoteTitle" Text="正在等待客户端设备链接"
                           FontSize="22" FontWeight="SemiBold" HorizontalAlignment="Center"
                           TextAlignment="Center" TextWrapping="Wrap"/>
                <TextBlock x:Name="RemoteHint" FontSize="13" Opacity="0.7" HorizontalAlignment="Center"
                           TextAlignment="Center" TextWrapping="Wrap"
                           Text="请在同一局域网内，用 Easy4K 手机客户端连接以下地址"/>
                <Border CornerRadius="10" Padding="24,14"
                        Background="{ThemeResource CardBgBrush}"
                        BorderBrush="{ThemeResource CardBorderBrush}" BorderThickness="1"
                        HorizontalAlignment="Center">
                    <StackPanel Spacing="6">
                        <TextBlock x:Name="RemoteAddress" FontFamily="Consolas" FontSize="22" FontWeight="SemiBold"
                                   HorizontalAlignment="Center" TextAlignment="Center"/>
                        <TextBlock x:Name="RemotePort" FontSize="12" Opacity="0.7"
                                   HorizontalAlignment="Center" TextAlignment="Center"/>
                    </StackPanel>
                </Border>
                <Button Content="结束远程控制" Click="OnStopRemoteControl"
                        HorizontalAlignment="Center" Style="{StaticResource GlassButton}"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
