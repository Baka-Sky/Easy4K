<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Easy4K.Views.Remote.RemoteClientPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    NavigationCacheMode="Required"
    mc:Ignorable="d">

    <Page.Resources>
        <Style x:Key="CardBorder" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource CardBgBrush}"/>
            <Setter Property="BorderBrush" Value="{ThemeResource CardBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="16"/>
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="MinWidth" Value="72"/>
            <Setter Property="FontFamily" Value="Segoe UI Medium"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
        </Style>
    </Page.Resources>

    <!-- 只负责「连上另一台 Easy4K」。连上后不在这里操作 —— 直接复用主页/高级/进行中三个页面，
         本页退到后台，窗口顶部进度条下方会出现黄色「已连接至 …」横幅。 -->
    <Grid x:Name="RootGrid" Padding="16,0,16,16">
        <StackPanel x:Name="ConnectPane" HorizontalAlignment="Center" VerticalAlignment="Center"
                    Spacing="14" Width="480">
            <TextBlock Text="遥控另一台 Easy4K" FontSize="20" FontWeight="SemiBold"
                       HorizontalAlignment="Center"/>
            <TextBlock FontSize="12" Opacity="0.7" TextWrapping="Wrap" TextAlignment="Center"
                       Text="在对方的 Easy4K 上打开「设置 → 远程控制 → 启动远程控制」，然后在这里填它的地址。连上后本窗口会直接复用「主页 / 高级 / 进行中」来操作对方电脑，不再另开界面。"/>

            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                <TextBox x:Name="HostBox" Width="250" PlaceholderText="对方 IP，例如 192.168.31.156"
                         Style="{StaticResource GlassTextBox}"/>
                <TextBlock Text=":" VerticalAlignment="Center" Opacity="0.7"/>
                <TextBox x:Name="PortBox" Width="72" Text="11451" Style="{StaticResource GlassTextBox}"/>
                <Button x:Name="ConnectButton" Content="连接" Click="OnConnect"
                        Style="{StaticResource GlassButton}"/>
            </StackPanel>

            <!-- 连接中：转圈 + 步骤文字（对标手机端体验） -->
            <StackPanel x:Name="ConnectBusy" Spacing="10" Visibility="Collapsed" HorizontalAlignment="Center">
                <ProgressRing IsActive="True" Width="48" Height="48" HorizontalAlignment="Center"/>
                <TextBlock x:Name="ConnectStep" FontSize="13" Opacity="0.8"
                           HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"/>
            </StackPanel>

            <InfoBar x:Name="ConnectError" IsOpen="False" Severity="Error"
                     IsClosable="False" Title="连接失败"/>

            <Border Style="{StaticResource CardBorder}">
                <StackPanel Spacing="6">
                    <TextBlock Text="连上之后可以做什么" FontWeight="SemiBold" FontSize="13"/>
                    <TextBlock FontSize="12" Opacity="0.75" TextWrapping="Wrap"
                               Text="· 主页：选远端电脑上的视频、选输出目录、勾选超分 / 补帧 / 帧去重 / 音频超分 / 涡轮模式；&#x0a;· 高级：与本地一致的进阶选项；&#x0a;· 进行中：看进度、CPU / GPU 占用、日志，并可停止 / 暂停。"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </Grid>
</Page>
