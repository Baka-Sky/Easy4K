<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Easy4K.Views.Welcome.WelcomeWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Easy4K">

    <Grid x:Name="RootLayout">
        <Grid.RowDefinitions>
            <RowDefinition Height="44"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 顶部标题栏（拖拽区） -->
        <Grid x:Name="TitleBar" Grid.Row="0" Padding="16,0" Background="Transparent">
            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <Image x:Name="TitleLogo" Width="20" Height="20" Stretch="Uniform"/>
                <TextBlock Text="Easy4K" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
            </StackPanel>
        </Grid>

        <!-- 内容宿主 -->
        <Grid Grid.Row="1">
            <!-- 第 1 步：欢迎（100% 复刻 ClassIsland WelcomePage 布局，普通文字，无方块动画） -->
            <Grid x:Name="StepWelcome">
                <!-- 正式内容：logo + 品牌字母 + 圆形下一步按钮 -->
                <Grid x:Name="WelcomeContent">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- 上区：logo（底部居中，80x80） -->
                    <Image x:Name="WelcomeLogo" Grid.Row="0" VerticalAlignment="Bottom"
                           HorizontalAlignment="Center" Margin="0,0,0,8"
                           Width="80" Height="80" Stretch="Uniform"/>

                    <!-- 中区：品牌字母行（仿原版 TextsMain） -->
                    <StackPanel Grid.Row="1" Orientation="Horizontal"
                                HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="E" FontSize="32" FontWeight="Medium" TextAlignment="Center"/>
                        <TextBlock Text="a" FontSize="32" FontWeight="Medium" TextAlignment="Center"/>
                        <TextBlock Text="s" FontSize="32" FontWeight="Medium" TextAlignment="Center"/>
                        <TextBlock Text="y" FontSize="32" FontWeight="Medium" TextAlignment="Center"/>
                        <TextBlock Text="4" FontSize="32" FontWeight="Medium" TextAlignment="Center"/>
                        <TextBlock Text="K" FontSize="32" FontWeight="Medium" TextAlignment="Center"/>
                    </StackPanel>

                    <!-- 下区：圆形下一步按钮（accent，48x48 圆角 24）+ 版本号 -->
                    <Grid Grid.Row="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Button x:Name="WelcomeNextBtn" Grid.Row="0" VerticalAlignment="Top"
                                HorizontalAlignment="Center" Margin="0,8,0,0"
                                Width="48" Height="48" CornerRadius="24"
                                Background="{ThemeResource AccentFillColorDefaultBrush}"
                                Foreground="White" BorderThickness="0"
                                Click="OnNext" ToolTipService.ToolTip="下一步">
                            <FontIcon Glyph="&#xE72A;" FontSize="18"/>
                        </Button>
                        <TextBlock x:Name="VersionText" Grid.Row="1" HorizontalAlignment="Center"
                                   Opacity="0.75" Margin="0,8,0,8" FontSize="12"/>
                    </Grid>
                </Grid>
            </Grid>

            <!-- ============ 第 2 步：协议声明 ============ -->
            <Grid x:Name="StepLicense" Visibility="Collapsed">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel MaxWidth="600" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12" Padding="0,16">
                        <TextBlock Text="协议声明" FontSize="24" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                        <TextBlock Text="在继续之前，请阅读以下 Easy4K 使用协议、开源许可与隐私说明。"
                                   HorizontalAlignment="Center" Opacity="0.7" TextAlignment="Center" Margin="0,0,0,8"/>
                        <TextBox x:Name="LicenseBox" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True"
                                 FontFamily="Consolas" FontSize="11" MinHeight="200" MaxHeight="280"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"/>
                        <CheckBox x:Name="AgreeLicenseCb" Content="我已阅读并同意 Easy4K 使用协议与开源许可"
                                  Checked="OnAgreeChanged" Unchecked="OnAgreeChanged"/>
                        <CheckBox x:Name="AgreePrivacyCb" Content="我已阅读并同意隐私与免责声明"
                                  Checked="OnAgreeChanged" Unchecked="OnAgreeChanged"/>
                        <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Center">
                            <Button x:Name="LicenseBackBtn" Content="&#xE72B;" FontFamily="Segoe Fluent Icons" FontSize="18"
                                    Width="48" Height="48" CornerRadius="24" Click="OnBack" ToolTipService.ToolTip="上一步"/>
                            <Button x:Name="LicenseNextBtn" Content="&#xE72A;" FontFamily="Segoe Fluent Icons" FontSize="18"
                                    Width="48" Height="48" CornerRadius="24" IsEnabled="False"
                                    Background="{ThemeResource AccentFillColorDefaultBrush}" Foreground="White" BorderThickness="0"
                                    Click="OnNext" ToolTipService.ToolTip="下一步"/>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- ============ 第 3 步：硬件声明 ============ -->
            <Grid x:Name="StepHardware" Visibility="Collapsed">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel MaxWidth="600" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12" Padding="0,16">
                        <TextBlock Text="硬件声明" FontSize="24" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                        <TextBlock Text="Easy4K 依赖你的显卡与第三方 AI 工具，请确认硬件满足以下最低要求。"
                                   HorizontalAlignment="Center" Opacity="0.7" TextAlignment="Center" Margin="0,0,0,8"/>
                        <TextBox x:Name="HardwareBox" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True"
                                 FontFamily="Consolas" FontSize="11" MinHeight="180" MaxHeight="260"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"/>
                        <TextBlock x:Name="HardwareDetected" TextWrapping="Wrap" FontSize="12" Opacity="0.9"/>
                        <CheckBox x:Name="AgreeHardwareCb" Content="我已了解硬件要求，并确认我的设备可以运行本软件"
                                  Checked="OnAgreeChanged" Unchecked="OnAgreeChanged"/>
                        <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Center">
                            <Button x:Name="HardwareBackBtn" Content="&#xE72B;" FontFamily="Segoe Fluent Icons" FontSize="18"
                                    Width="48" Height="48" CornerRadius="24" Click="OnBack" ToolTipService.ToolTip="上一步"/>
                            <Button x:Name="HardwareNextBtn" Content="&#xE72A;" FontFamily="Segoe Fluent Icons" FontSize="18"
                                    Width="48" Height="48" CornerRadius="24" IsEnabled="False"
                                    Background="{ThemeResource AccentFillColorDefaultBrush}" Foreground="White" BorderThickness="0"
                                    Click="OnNext" ToolTipService.ToolTip="下一步"/>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- ============ 第 4 步：配置软件 ============ -->
            <Grid x:Name="StepConfig" Visibility="Collapsed">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel MaxWidth="600" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12" Padding="0,16">
                        <TextBlock Text="配置软件" FontSize="24" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                        <TextBlock Text="选择软件默认启用的处理步骤。启动时软件会先用一段 1 秒测试视频按这里的默认步骤自检，通过后再进入正式使用。"
                                   HorizontalAlignment="Center" Opacity="0.7" TextAlignment="Center" Margin="0,0,0,4"/>
                        <TextBlock Text="高级功能选择" FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                        <Border Background="{ThemeResource CardBgBrush}" BorderBrush="{ThemeResource CardBorderBrush}"
                                BorderThickness="1" CornerRadius="8" Padding="18,14">
                            <StackPanel Spacing="8">
                                <CheckBox x:Name="CfgSplitCb" Content="拆帧（将视频导出为帧序列）"/>
                                <CheckBox x:Name="CfgSrCb" Content="AI 超分（Real-ESRGAN）"/>
                                <CheckBox x:Name="CfgIfCb" Content="AI 补帧（RIFE / Offical）"/>
                                <CheckBox x:Name="CfgMergeCb" Content="合并视频（编码输出）"/>
                                <CheckBox x:Name="CfgAudioCb" Content="嵌入原音频"/>
                            </StackPanel>
                        </Border>
                        <ToggleSwitch x:Name="CfgStartupTestTs" Header="每次启动先跑测试视频自检" OnContent="开启" OffContent="关闭" IsOn="True"/>
                        <ToggleSwitch x:Name="CfgReportTs" OnContent="生成" OffContent="不生成"
                                      ToolTipService.ToolTip="勾选开关后，每次正式处理完成都会生成一份 HTML 报告；选择“不生成”则不写任何报告文件，相当于完全不生成配置文件。">
                            <ToggleSwitch.Header>
                                <TextBlock Text="处理完成后生成配置文件（HTML 处理报告）" TextWrapping="Wrap" MaxWidth="520"/>
                            </ToggleSwitch.Header>
                        </ToggleSwitch>
                        <TextBlock Text="模型 / 倍率 / 线程等更多默认参数，可在进入软件后在主界面调整并“保存当前设置为默认”。"
                                   Opacity="0.6" FontSize="12" TextWrapping="Wrap"/>
                        <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Center">
                            <Button x:Name="CfgBackBtn" Content="&#xE72B;" FontFamily="Segoe Fluent Icons" FontSize="18"
                                    Width="48" Height="48" CornerRadius="24" Click="OnBack" ToolTipService.ToolTip="上一步"/>
                            <Button x:Name="CfgNextBtn" Content="&#xE72A;" FontFamily="Segoe Fluent Icons" FontSize="18"
                                    Width="48" Height="48" CornerRadius="24"
                                    Background="{ThemeResource AccentFillColorDefaultBrush}" Foreground="White" BorderThickness="0"
                                    Click="OnNext" ToolTipService.ToolTip="下一步"/>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- ============ 第 5 步：处理报告配置 ============ -->
            <Grid x:Name="StepReport" Visibility="Collapsed">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel MaxWidth="600" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12" Padding="0,16">
                        <TextBlock Text="处理报告配置" FontSize="24" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                        <TextBlock Text="每次视频处理完成后，Easy4K 会自动生成一份 HTML 报告并保存到下面指定的目录。"
                                   HorizontalAlignment="Center" Opacity="0.7" TextAlignment="Center" Margin="0,0,0,8"/>
                        <TextBox x:Name="ReportDesc" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True"
                                 FontFamily="Consolas" FontSize="11" MinHeight="120" MaxHeight="180"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"/>
                        <ToggleSwitch x:Name="ReportEnabledTs" Header="处理完成后自动生成 HTML 报告" OnContent="开启" OffContent="关闭"/>
                        <ToggleSwitch x:Name="ReportAutoOpenTs" Header="生成后自动用浏览器打开" OnContent="开启" OffContent="关闭" IsOn="True"/>
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="ReportDirBox" Grid.Column="0" Header="报告保存目录" Text="Reports"
                                     TextWrapping="NoWrap" VerticalAlignment="Bottom"/>
                            <Button Grid.Column="1" Content="浏览..." Click="OnBrowseReportDir" VerticalAlignment="Bottom"
                                    Style="{StaticResource GlassButton}"/>
                        </Grid>
                        <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Center">
                            <Button x:Name="ReportBackBtn" Content="&#xE72B;" FontFamily="Segoe Fluent Icons" FontSize="18"
                                    Width="48" Height="48" CornerRadius="24" Click="OnBack" ToolTipService.ToolTip="上一步"/>
                            <Button x:Name="ReportNextBtn" Content="&#xE72A;" FontFamily="Segoe Fluent Icons" FontSize="18"
                                    Width="48" Height="48" CornerRadius="24"
                                    Background="{ThemeResource AccentFillColorDefaultBrush}" Foreground="White" BorderThickness="0"
                                    Click="OnNext" ToolTipService.ToolTip="下一步"/>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- ============ 第 6 步：选择默认主题配置 ============ -->
            <Grid x:Name="StepTheme" Visibility="Collapsed">
                <StackPanel MaxWidth="600" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="14">
                    <TextBlock Text="选择默认主题配置" FontSize="24" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                    <TextBlock Text="选择 Easy4K 的默认外观。之后你随时可以在菜单里切换主题。"
                               HorizontalAlignment="Center" Opacity="0.7" Margin="0,0,0,8"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="10">
                        <RadioButton x:Name="ThemeLightRb" Content="浅色" Checked="OnThemeChanged"/>
                        <RadioButton x:Name="ThemeDarkRb" Content="深色" Checked="OnThemeChanged"/>
                        <RadioButton x:Name="ThemeAcrylicRb" Content="亚克力" Checked="OnThemeChanged"/>
                        <RadioButton x:Name="ThemeSystemRb" Content="跟随系统" IsChecked="True" Checked="OnThemeChanged"/>
                    </StackPanel>
                    <TextBlock Text="预览" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                    <Border Width="300" Height="90" CornerRadius="10" BorderThickness="1" BorderBrush="{ThemeResource CardBorderBrush}"
                            Background="{ThemeResource CardBgBrush}">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="6">
                            <TextBlock Text="Aa" FontSize="26" FontWeight="Bold" HorizontalAlignment="Center"/>
                            <TextBlock Text="Easy4K" Opacity="0.6" FontSize="12" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Center">
                        <Button x:Name="ThemeBackBtn" Content="&#xE72B;" FontFamily="Segoe Fluent Icons" FontSize="18"
                                Width="48" Height="48" CornerRadius="24" Click="OnBack" ToolTipService.ToolTip="上一步"/>
                        <Button x:Name="ThemeNextBtn" Content="&#xE72A;" FontFamily="Segoe Fluent Icons" FontSize="18"
                                Width="48" Height="48" CornerRadius="24"
                                Background="{ThemeResource AccentFillColorDefaultBrush}" Foreground="White" BorderThickness="0"
                                Click="OnNext" ToolTipService.ToolTip="下一步"/>
                    </StackPanel>
                </StackPanel>
            </Grid>

            <!-- ============ 第 7 步：完成 ============ -->
            <Grid x:Name="StepFinish" Visibility="Collapsed">
                <StackPanel MaxWidth="600" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="16">
                    <FontIcon Glyph="&#xE73E;" FontSize="46" Foreground="{ThemeResource AccentFillColorDefaultBrush}"
                              HorizontalAlignment="Center"/>
                    <TextBlock Text="完成" FontSize="26" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                    <TextBlock x:Name="FinishSummary" TextWrapping="Wrap" TextAlignment="Center" Opacity="0.8" FontSize="13" Margin="0,0,0,8"/>
                    <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Center">
                        <Button x:Name="FinishBackBtn" Content="&#xE72B;" FontFamily="Segoe Fluent Icons" FontSize="18"
                                Width="48" Height="48" CornerRadius="24" Click="OnBack" ToolTipService.ToolTip="上一步"/>
                        <Button x:Name="FinishLaunchBtn" Content="启动 Easy4K" Click="OnFinishLaunch" HorizontalAlignment="Center"
                                Style="{StaticResource GlassButton}" Padding="24,10"/>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</Window>