<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Easy4K.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:Easy4K"
    xmlns:models="using:Easy4K.Models"
    xmlns:vm="using:Easy4K.ViewModels"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Page.Resources>
        <ResourceDictionary>
            <!-- 主题画笔（CardBgBrush/CardBorderBrush/WarnBgBrush）与玻璃样式已上移至 App.xaml -->

            <Style x:Key="CardBorder" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource CardBgBrush}"/>
                <Setter Property="BorderBrush" Value="{ThemeResource CardBorderBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CornerRadius" Value="8"/>
                <Setter Property="Padding" Value="16"/>
            </Style>
            <Style x:Key="SectionTitle" TargetType="TextBlock">
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="Margin" Value="0,0,0,8"/>
            </Style>
            <Style x:Key="FieldLabel" TargetType="TextBlock">
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="MinWidth" Value="80"/>
                <!-- Win11 Segoe UI 行高差异：指定具体字体变体保证跨版本对齐（替代 Margin hack） -->
                <Setter Property="FontFamily" Value="{StaticResource AppFontMediumFamily}"/>
                <Setter Property="Margin" Value="0,0,8,0"/>
            </Style>
            <!-- 转换器已移除：进度用 x:Bind 格式化，颜色用 LogEntry.LevelColorHex，可见性用 x:Bind 条件 -->
        </ResourceDictionary>
    </Page.Resources>

    <Grid Padding="16,0,16,16">
        <ScrollViewer Padding="0,8,0,0" VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="10">

                <TextBlock Text="主页 标准模式" FontSize="20" FontWeight="Bold" Margin="0,2,0,4"/>

                <!-- 路径 -->
                <Border Style="{StaticResource CardBorder}">
                    <StackPanel Spacing="6">
                        <TextBlock Text="输入输出" Style="{StaticResource SectionTitle}"/>
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="输入视频" Style="{StaticResource FieldLabel}"/>
                            <TextBox  Grid.Column="1" Text="{x:Bind Vm.InputVideo, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{x:Bind Vm.BrowseInputEnabled, Mode=OneWay}" PlaceholderText="选择或输入 .mp4/.mkv/.avi/.mov 路径" TextChanged="OnInputVideoTextChanged" Style="{StaticResource GlassTextBox}"/>
                            <Button   Grid.Column="2" Content="浏览" Click="OnBrowseInput" IsEnabled="{x:Bind Vm.BrowseInputEnabled, Mode=OneWay}" Margin="0,0,8,0" Style="{StaticResource GlassButton}"/>
                            <Button   Grid.Column="3" Content="清除" Click="OnClearInputVideo" IsEnabled="{x:Bind Vm.HasInputVideo, Mode=OneWay}" Style="{StaticResource GlassButton}"/>
                        </Grid>
                        <Grid ColumnSpacing="8" Margin="0,4,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="帧文件夹" Style="{StaticResource FieldLabel}"/>
                            <TextBox  Grid.Column="1" Text="{x:Bind Vm.ExternalFramesDir, Mode=OneWay}" IsEnabled="{x:Bind Vm.ImportFramesEnabled, Mode=OneWay}" PlaceholderText="未导入（默认先拆帧）" TextChanged="OnFrameFolderTextChanged" Style="{StaticResource GlassTextBox}"/>
                            <Button   Grid.Column="2" Content="导入" Click="OnImportFrameFolder" IsEnabled="{x:Bind Vm.ImportFramesEnabled, Mode=OneWay}" Margin="0,0,8,0" Style="{StaticResource GlassButton}"/>
                            <Button   Grid.Column="3" Content="清除" Click="OnClearFrameFolder" IsEnabled="{x:Bind Vm.HasExternalFrames, Mode=OneWay}" Style="{StaticResource GlassButton}"/>
                        </Grid>
                        <TextBlock Text="可选：导入已有 PNG 帧文件夹可跳过拆帧（与输入视频二选一）" FontSize="10" Opacity="0.6"/>
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="临时目录" Style="{StaticResource FieldLabel}"/>
                            <TextBox  Grid.Column="1" Text="{x:Bind Vm.TempRoot, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="中间帧输出目录" Style="{StaticResource GlassTextBox}"/>
                            <Button   Grid.Column="2" Content="浏览" Click="OnBrowseTemp" Style="{StaticResource GlassButton}"/>
                        </Grid>
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="输出目录" Style="{StaticResource FieldLabel}"/>
                            <TextBox  Grid.Column="1" Text="{x:Bind Vm.OutputRoot, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="成品视频输出目录" Style="{StaticResource GlassTextBox}"/>
                            <Button   Grid.Column="2" Content="浏览" Click="OnBrowseOutput" Style="{StaticResource GlassButton}"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- 视频信息 + 处理选项 -->
                <Grid ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource CardBorder}">
                        <StackPanel Spacing="4">
                            <TextBlock Text="输入视频信息 (自动检测)" Style="{StaticResource SectionTitle}"/>
                            <TextBlock Text="{x:Bind Vm.VideoInfoText, Mode=OneWay}" TextWrapping="Wrap" FontSize="12"/>
                            <TextBlock Text="输出分辨率" FontWeight="SemiBold" FontSize="12" Margin="0,4,0,0"/>
                            <TextBlock Text="{x:Bind Vm.OutputResolutionText, Mode=OneWay}" FontSize="12"/>
                            <TextBlock Text="目标帧率" FontWeight="SemiBold" FontSize="12" Margin="0,4,0,0"/>
                            <TextBlock Text="{x:Bind Vm.TargetFpsText, Mode=OneWay}" FontSize="12"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="1" Style="{StaticResource CardBorder}">
                        <StackPanel Spacing="4">
                            <TextBlock Text="处理选项" Style="{StaticResource SectionTitle}"/>
                            <CheckBox Content="拆帧" IsChecked="{x:Bind Vm.SplitFrames, Mode=TwoWay}" IsEnabled="{x:Bind Vm.SplitFramesLocked, Mode=OneWay}" FontSize="12"/>
                            <CheckBox Content="超分" IsChecked="{x:Bind Vm.SuperResolution, Mode=TwoWay}" FontSize="12"/>
                            <CheckBox Content="补帧" IsChecked="{x:Bind Vm.Interpolation, Mode=TwoWay}" FontSize="12"/>
                            <CheckBox Content="合并视频 (依赖拆帧)" IsChecked="{x:Bind Vm.MergeVideo, Mode=TwoWay}" FontSize="12"/>
                            <CheckBox Content="SDR -> HDR 转换" IsChecked="{x:Bind Vm.SdrToHdr, Mode=TwoWay}" IsEnabled="{x:Bind Vm.IsHdrEnabled, Mode=OneWay}" FontSize="12"/>
                            <!-- 只在检测到字幕流时可勾：没有字幕时禁用以免造成"勾了但没用"的误解 -->
                            <CheckBox Content="保留原视频内嵌字幕" IsChecked="{x:Bind Vm.KeepSubtitles, Mode=TwoWay}"
                                      IsEnabled="{x:Bind Vm.KeepSubtitlesEnabled, Mode=OneWay}" FontSize="12"/>
                            <TextBlock Text="仅在原视频确实带字幕流时可勾；成片是从帧序列重建的，字幕会从原文件复制过来。"
                                       FontSize="10" Opacity="0.6" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- 超分 + 补帧设置 -->
                <Grid ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource CardBorder}">
                        <StackPanel Spacing="6">
                            <TextBlock Text="超分设置" Style="{StaticResource SectionTitle}"/>
                            <!-- 先选算法（引擎），再选该算法下的具体模型 -->
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="50"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="算法" VerticalAlignment="Center" FontSize="12" FontFamily="{StaticResource AppFontMediumFamily}"/>
                                <ComboBox Grid.Column="1" x:Name="SrEngineCombo" MinWidth="200" HorizontalAlignment="Stretch" PlaceholderText="选择算法" Style="{StaticResource GlassComboBox}" SelectionChanged="OnSrEngineSelectionChanged"/>
                            </Grid>
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="50"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="模型" VerticalAlignment="Center" FontSize="12" FontFamily="{StaticResource AppFontMediumFamily}"/>
                                <ComboBox Grid.Column="1" ItemsSource="{x:Bind Vm.SrModels}" SelectedItem="{x:Bind Vm.SrModel, Mode=TwoWay}" MinWidth="200" HorizontalAlignment="Stretch" PlaceholderText="选择模型" Style="{StaticResource GlassComboBox}"/>
                            </Grid>
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="50"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="倍率" VerticalAlignment="Center" FontSize="12" FontFamily="{StaticResource AppFontMediumFamily}"/>
                                <ComboBox Grid.Column="1" SelectedItem="{x:Bind Vm.SrScale, Mode=TwoWay}" MinWidth="200" HorizontalAlignment="Stretch">
                                    <x:Int32>2</x:Int32>
                                    <x:Int32>3</x:Int32>
                                    <x:Int32>4</x:Int32>
                                </ComboBox>
                            </Grid>
                            <TextBlock Text="{x:Bind Vm.OutputResolutionText, Mode=OneWay}" Opacity="0.6" FontSize="11"/>
                            <!-- 适合场景 + 推荐星级：跟着上面「算法 + 模型」联动 -->
                            <TextBlock Text="{x:Bind Vm.SrSceneText, Mode=OneWay}" TextWrapping="Wrap" TextAlignment="Right"
                                       HorizontalAlignment="Right" Opacity="0.55" FontSize="11" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="1" Style="{StaticResource CardBorder}">
                        <StackPanel Spacing="6">
                            <TextBlock Text="补帧设置" Style="{StaticResource SectionTitle}"/>
                            <!-- 先选种类（模型族），再选该族下的具体模型 -->
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="64"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="种类" VerticalAlignment="Center" FontSize="12" FontFamily="{StaticResource AppFontMediumFamily}"/>
                                <ComboBox Grid.Column="1" x:Name="IfEngineCombo" MinWidth="200" HorizontalAlignment="Stretch" PlaceholderText="选择种类" Style="{StaticResource GlassComboBox}" SelectionChanged="OnIfEngineSelectionChanged"/>
                            </Grid>
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="64"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="模型" VerticalAlignment="Center" FontSize="12" FontFamily="{StaticResource AppFontMediumFamily}"/>
                                <ComboBox Grid.Column="1" x:Name="IfModelCombo" MinWidth="200" HorizontalAlignment="Stretch" PlaceholderText="选择模型" Style="{StaticResource GlassComboBox}" SelectionChanged="OnIfModelSelectionChanged"/>
                            </Grid>
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="64"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="倍率" VerticalAlignment="Center" FontSize="12" FontFamily="{StaticResource AppFontMediumFamily}"/>
                                <ComboBox Grid.Column="1" SelectedItem="{x:Bind Vm.IfMultiplier, Mode=TwoWay}" IsEnabled="{x:Bind Vm.IfMultiplierEnabled, Mode=OneWay}" MinWidth="200" HorizontalAlignment="Stretch" Style="{StaticResource GlassComboBox}">
                                    <x:Int32>2</x:Int32>
                                    <x:Int32>3</x:Int32>
                                    <x:Int32>4</x:Int32>
                                    <x:Int32>5</x:Int32>
                                </ComboBox>
                            </Grid>
                            <!-- 目标帧率：填了它就以它为准（成片 fps 精确等于该值，避免 23.976×2=47.952 这种小数），
                                 下面那行会顺手算出实际比例与总帧数；填 0 = 回到上面的倍率 -->
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="64"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="目标帧率" VerticalAlignment="Center" FontSize="12" FontFamily="{StaticResource AppFontMediumFamily}"/>
                                <NumberBox Grid.Column="1" Value="{x:Bind Vm.TargetFps, Mode=TwoWay}" Minimum="0" Maximum="1000"
                                           SpinButtonPlacementMode="Hidden"
                                           PlaceholderText="0 = 按倍率；填目标帧率则成片 fps 精确等于它"
                                           IsEnabled="{x:Bind Vm.TargetFpsEnabled, Mode=OneWay}"
                                           HorizontalAlignment="Stretch"/>
                            </Grid>
                            <TextBlock Text="{x:Bind Vm.TargetFpsText, Mode=OneWay}" Opacity="0.6" FontSize="11"/>
                            <TextBlock Text="{x:Bind Vm.VramWarning, Mode=OneWay}" TextWrapping="Wrap" Foreground="{x:Bind Vm.VramWarningBrush, Mode=OneWay}" FontSize="11"/>
                            <!-- 适合场景：跟着上面「种类 + 模型」联动，说明当前选中的这个版本适合什么素材 -->
                            <TextBlock Text="{x:Bind Vm.IfSceneText, Mode=OneWay}" TextWrapping="Wrap" TextAlignment="Right"
                                       HorizontalAlignment="Right" Opacity="0.55" FontSize="11" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- 音频 -->
                <Border Style="{StaticResource CardBorder}">
                    <StackPanel Spacing="6">
                        <TextBlock Text="音频设置" Style="{StaticResource SectionTitle}"/>
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Button   Grid.Column="0" Content="提取音频" Click="OnExtractAudio" IsEnabled="{x:Bind Vm.ExtractAudioEnabled, Mode=OneWay}" Style="{StaticResource GlassButton}"/>
                            <TextBlock Grid.Column="1" Text="{x:Bind Vm.ExtractedAudioPath, Mode=OneWay}" VerticalAlignment="Center" IsTextSelectionEnabled="True" Opacity="0.6" TextTrimming="CharacterEllipsis" FontSize="11" FontFamily="{StaticResource AppFontMediumFamily}"/>
                            <TextBlock Grid.Column="2" Text="{x:Bind Vm.AudioPipelineLabel, Mode=OneWay}" VerticalAlignment="Center" Opacity="0.6" FontSize="11" FontFamily="{StaticResource AppFontMediumFamily}"/>
                        </Grid>
                        <CheckBox Content="将原音频合并进新视频 (处理结束时自动提取并合并)" IsChecked="{x:Bind Vm.MergeAudio, Mode=TwoWay}" IsEnabled="{x:Bind Vm.MergeAudioEnabled, Mode=OneWay}" FontSize="12"/>
                    </StackPanel>
                </Border>

                <!-- 单文件超分：只处理一张图片或一个音频文件，不走完整流水线（不拆帧/不补帧/不合并） -->
                <Border Style="{StaticResource CardBorder}">
                    <StackPanel Spacing="6">
                        <TextBlock Text="单文件超分" Style="{StaticResource SectionTitle}"/>
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="类型" Style="{StaticResource FieldLabel}"/>
                            <ComboBox x:Name="SfKindCombo" Grid.Column="1" SelectedIndex="{x:Bind Vm.SfKindIndex, Mode=TwoWay}" MinWidth="110" Style="{StaticResource GlassComboBox}">
                                <x:String>图片</x:String>
                                <x:String>音频</x:String>
                                <x:String>视频 HDR</x:String>
                            </ComboBox>
                            <TextBlock Grid.Column="2" Text="只处理这一个文件，不拆帧/不补帧/不合并" VerticalAlignment="Center" Opacity="0.6" FontSize="11"/>
                        </Grid>
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="输入文件" Style="{StaticResource FieldLabel}"/>
                            <TextBox  Grid.Column="1" Text="{x:Bind Vm.SfInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      IsEnabled="{x:Bind Vm.SfIdle, Mode=OneWay}"
                                      PlaceholderText="图片（png/jpg/webp）/ 音频（wav/mp3/flac…）/ 视频（mp4/mkv…）" Style="{StaticResource GlassTextBox}"/>
                            <Button   Grid.Column="2" Content="浏览" Click="OnBrowseSfInput" IsEnabled="{x:Bind Vm.SfIdle, Mode=OneWay}" Margin="0,0,8,0" Style="{StaticResource GlassButton}"/>
                            <Button   Grid.Column="3" Content="清除" Click="OnClearSfInput" IsEnabled="{x:Bind Vm.SfIdle, Mode=OneWay}" Style="{StaticResource GlassButton}"/>
                        </Grid>
                        <!-- 图片：超分模型 + 倍率（模型列表按倍率过滤，与上方主管线设置互不影响） -->
                        <Grid ColumnSpacing="8" Visibility="{x:Bind Vm.SfImageRowVis, Mode=OneWay}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="超分模型" Style="{StaticResource FieldLabel}"/>
                            <ComboBox Grid.Column="1" ItemsSource="{x:Bind Vm.SfImageModels}" SelectedItem="{x:Bind Vm.SfImageModel, Mode=TwoWay}"
                                      MinWidth="200" HorizontalAlignment="Stretch" PlaceholderText="选择模型" Style="{StaticResource GlassComboBox}"/>
                            <TextBlock Grid.Column="2" Text="倍率" VerticalAlignment="Center" FontSize="12" FontFamily="{StaticResource AppFontMediumFamily}" Margin="0,0,8,0"/>
                            <ComboBox Grid.Column="3" SelectedItem="{x:Bind Vm.SfImageScale, Mode=TwoWay}" MinWidth="80">
                                <x:Int32>2</x:Int32>
                                <x:Int32>3</x:Int32>
                                <x:Int32>4</x:Int32>
                            </ComboBox>
                        </Grid>
                        <!-- 音频：AudioSR 精度档 -->
                        <Grid ColumnSpacing="8" Visibility="{x:Bind Vm.SfAudioRowVis, Mode=OneWay}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="精度" Style="{StaticResource FieldLabel}"/>
                            <ComboBox Grid.Column="1" SelectedItem="{x:Bind Vm.SfAudioPrecision, Mode=TwoWay}" MinWidth="200"
                                      SelectionChanged="OnSfPrecisionSelectionChanged"
                                      HorizontalAlignment="Stretch" Style="{StaticResource GlassComboBox}">
                                <x:String>fp16</x:String>
                                <x:String>fp32</x:String>
                            </ComboBox>
                        </Grid>
                        <!-- 视频 HDR：参数沿用主管线「HDR 参数」的饱和度/对比度 -->
                        <Grid ColumnSpacing="8" Visibility="{x:Bind Vm.SfHdrRowVis, Mode=OneWay}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="HDR 参数" Style="{StaticResource FieldLabel}"/>
                            <TextBlock Grid.Column="1" VerticalAlignment="Center" FontSize="11" Opacity="0.6" TextWrapping="Wrap"
                                       Text="沿用下方「HDR 参数」的饱和度/对比度；需要 NVIDIA RTX 20/30/40/50 系列 + NVEncC，输出 HDR10 的 MKV。"/>
                        </Grid>
                        <TextBlock Text="{x:Bind Vm.SfOutputText, Mode=OneWay}" Opacity="0.6" FontSize="11" TextTrimming="CharacterEllipsis"/>
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Content="{x:Bind Vm.SfStartButtonText, Mode=OneWay}" Click="OnStartSingleFile" IsEnabled="{x:Bind Vm.CanStartSingle, Mode=OneWay}" Style="{StaticResource GlassButton}"/>
                            <Button Grid.Column="1" Content="停止" Click="OnStopSingleFile" IsEnabled="{x:Bind Vm.CanStopSingle, Mode=OneWay}" Style="{StaticResource GlassButton}"/>
                            <TextBlock Grid.Column="2" Text="{x:Bind Vm.SfStatus, Mode=OneWay}" VerticalAlignment="Center" FontSize="11"
                                       TextWrapping="Wrap" IsTextSelectionEnabled="True" Opacity="0.8"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- HDR 参数 -->
                <Border Style="{StaticResource CardBorder}" Visibility="{x:Bind Vm.SdrToHdrVis, Mode=OneWay}">
                    <StackPanel Spacing="6">
                        <TextBlock Text="HDR 参数" Style="{StaticResource SectionTitle}"/>
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="饱和度" VerticalAlignment="Center" FontSize="12" FontFamily="{StaticResource AppFontMediumFamily}"/>
                            <NumberBox Grid.Column="1" Value="{x:Bind Vm.HdrSaturation, Mode=TwoWay}"
                                       Minimum="0" Maximum="200" SpinButtonPlacementMode="Compact"
                                       SmallChange="1" LargeChange="10" FontSize="12" Style="{StaticResource GlassNumberBox}"/>
                            <TextBlock Grid.Column="2" Text="对比度" VerticalAlignment="Center" FontSize="12" FontFamily="{StaticResource AppFontMediumFamily}"/>
                            <NumberBox Grid.Column="3" Value="{x:Bind Vm.HdrContrast, Mode=TwoWay}"
                                       Minimum="0" Maximum="200" SpinButtonPlacementMode="Compact"
                                       SmallChange="1" LargeChange="10" FontSize="12" Style="{StaticResource GlassNumberBox}"/>
                        </Grid>
                        <TextBlock Text="范围 0 ~ 200（NVEncC 最高 200，默认 200）" FontSize="10" Opacity="0.6"/>
                    </StackPanel>
                </Border>

                <!-- 高级性能选项已移到「高级模式」页（标题下的模式条切换） -->

                <Border Style="{StaticResource CardBorder}">
                    <StackPanel Spacing="6">
                        <TextBlock Text="提示" Style="{StaticResource SectionTitle}"/>
                        <!-- 显卡状态（绿=可运行 / 黄=勉强 / 红=不行） -->
                        <Border Background="{x:Bind Vm.GpuStatusBrush, Mode=OneWay}" CornerRadius="4" Padding="10,6"
                                Visibility="{x:Bind Vm.GpuStatusVis, Mode=OneWay}">
                            <TextBlock Text="{x:Bind Vm.GpuStatusText, Mode=OneWay}"
                                       Foreground="{x:Bind Vm.GpuStatusForeground, Mode=OneWay}"
                                       FontSize="12" TextWrapping="Wrap"/>
                        </Border>
                        <TextBlock Text="{x:Bind Vm.Warnings, Mode=OneWay}" TextWrapping="Wrap" FontSize="11"/>
                        <CheckBox Content="以后不再爆红" IsChecked="{x:Bind Vm.SuppressRedWarning, Mode=TwoWay}" FontSize="12"/>
                        <TextBlock Text="免责声明：本软件按现状提供，处理结果与设备风险（高负载/发热/崩溃等）由使用者自行承担，开发者不承担任何责任。详见菜单栏「帮助 → 关于」。" TextWrapping="Wrap" FontSize="10" Opacity="0.6" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>

                <!-- 按钮（进度与日志已移至"进行中"页） -->
                <Border Style="{StaticResource CardBorder}">
                    <StackPanel Spacing="8">
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Content="开始处理" Click="OnStart" IsEnabled="{x:Bind Vm.CanStart, Mode=OneWay}" Style="{StaticResource GlassButton}"/>
                            <Button Grid.Column="1" Content="停止" Click="OnStop" IsEnabled="{x:Bind Vm.CanStop, Mode=OneWay}" Style="{StaticResource GlassButton}"/>
                            <Button Grid.Column="2" Content="清理临时文件" Click="OnCleanTemp" IsEnabled="{x:Bind Vm.CanClean, Mode=OneWay}" Style="{StaticResource GlassButton}"/>
                            <!-- 孤儿模式：与上面三个按钮同一排且齐平，但靠窗口最右侧。
                                 未选输入时按钮禁用并给出与「开始处理」一致的原因提示。 -->
                            <Button Grid.Column="3" Content="将此任务添加为孤儿执行任务" Click="OnAddOrphanTask"
                                    IsEnabled="{x:Bind Vm.CanStart, Mode=OneWay}"
                                    HorizontalAlignment="Right" Style="{StaticResource GlassButton}"/>
                        </Grid>
                        <TextBlock Text="{x:Bind Vm.CanStartReason, Mode=OneWay}" Foreground="Orange" FontSize="11" TextWrapping="Wrap"
                                   Visibility="{x:Bind Vm.StartBlockReasonVis, Mode=OneWay}"/>
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{x:Bind Vm.FinalOutputName, Mode=OneWay}" Opacity="0.6" FontSize="11"
                                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                            <!-- 孤儿模式说明与上一行「输出文件名」同一排，靠窗口最右侧 -->
                            <TextBlock Grid.Column="1"
                                       Text="孤儿模式：到点自动启动 Easy4K，按上面的选项处理这支视频，跑完自动关闭；可依次排队多个任务。"
                                       FontSize="10" Opacity="0.6" TextWrapping="Wrap"
                                       HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>
                        <StackPanel Spacing="3" Visibility="{x:Bind Vm.OrphanListVis, Mode=OneWay}">
                            <TextBlock Text="{x:Bind Vm.OrphanCountText, Mode=OneWay}" FontWeight="SemiBold" FontSize="12"/>
                            <ItemsControl ItemsSource="{x:Bind Vm.OrphanTasks}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="models:OrphanTask">
                                        <Grid ColumnSpacing="8" Margin="0,1,0,1">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{x:Bind RunAtText}" FontSize="11"
                                                       FontFamily="{StaticResource AppFontMediumFamily}" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="1" Text="{x:Bind DateText}" FontSize="11"
                                                       Opacity="0.5" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="2" Text="{x:Bind DisplayName}" FontSize="11"
                                                       Opacity="0.8" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                            <Button Grid.Column="3" Content="删除" Click="OnRemoveOrphanTask"
                                                    Tag="{x:Bind Id}" FontSize="11" Padding="8,2" Style="{StaticResource GlassButton}"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
