<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Easy4K.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:Easy4K"
    xmlns:models="using:Easy4K.Models"
    xmlns:vm="using:Easy4K.ViewModels"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Page.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="CardBgBrush" Color="#FFF5F5F5"/>
                    <SolidColorBrush x:Key="CardBorderBrush" Color="#FFC8C8C8"/>
                    <SolidColorBrush x:Key="WarnBgBrush" Color="#20FFB300"/>
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="CardBgBrush" Color="#FF2A2A2A"/>
                    <SolidColorBrush x:Key="CardBorderBrush" Color="#FF444444"/>
                    <SolidColorBrush x:Key="WarnBgBrush" Color="#30FFB300"/>
                </ResourceDictionary>
                <ResourceDictionary x:Key="HighContrast">
                    <SolidColorBrush x:Key="CardBgBrush" Color="{ThemeResource SystemColorWindowColor}"/>
                    <SolidColorBrush x:Key="CardBorderBrush" Color="{ThemeResource SystemColorWindowTextColor}"/>
                    <SolidColorBrush x:Key="WarnBgBrush" Color="{ThemeResource SystemColorWindowColor}"/>
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>

            <Style x:Key="CardBorder" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource CardBgBrush}"/>
                <Setter Property="BorderBrush" Value="{ThemeResource CardBorderBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CornerRadius" Value="8"/>
                <Setter Property="Padding" Value="16"/>
            </Style>
            <Style x:Key="SectionTitle" TargetType="TextBlock">
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="Margin" Value="0,0,0,8"/>
            </Style>
            <Style x:Key="FieldLabel" TargetType="TextBlock">
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="MinWidth" Value="80"/>
                <Setter Property="Margin" Value="0,0,8,0"/>
            </Style>
            <!-- 转换器已移除：进度用 x:Bind 格式化，颜色用 LogEntry.LevelColorHex，可见性用 x:Bind 条件 -->
        </ResourceDictionary>
    </Page.Resources>

    <Page.KeyboardAccelerators>
        <KeyboardAccelerator Key="O" Modifiers="Control" Invoked="OnAcceleratorOpen"/>
        <KeyboardAccelerator Key="S" Modifiers="Control" Invoked="OnAcceleratorStart"/>
        <KeyboardAccelerator Key="S" Modifiers="Control,Shift" Invoked="OnAcceleratorStop"/>
        <KeyboardAccelerator Key="L" Modifiers="Control" Invoked="OnAcceleratorClearLog"/>
        <KeyboardAccelerator Key="F1" Invoked="OnAcceleratorHelp"/>
    </Page.KeyboardAccelerators>

    <Grid Padding="16,0,16,16">
        <ScrollViewer Padding="0,8,0,0" VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="10">

                <TextBlock Text="Easy4K 一键视频超分补帧工具" FontSize="20" FontWeight="Bold" Margin="0,2,0,4"/>

                <!-- 路径 -->
                <Border Style="{StaticResource CardBorder}">
                    <StackPanel Spacing="6">
                        <TextBlock Text="输入输出" Style="{StaticResource SectionTitle}"/>
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="输入视频" Style="{StaticResource FieldLabel}"/>
                            <TextBox  Grid.Column="1" Text="{x:Bind Vm.InputVideo, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="True" PlaceholderText="选择 .mp4/.mkv/.avi/.mov 文件"/>
                            <Button   Grid.Column="2" Content="浏览" Click="OnBrowseInput"/>
                        </Grid>
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="临时目录" Style="{StaticResource FieldLabel}"/>
                            <TextBox  Grid.Column="1" Text="{x:Bind Vm.TempRoot, Mode=TwoWay}" IsReadOnly="True"/>
                            <Button   Grid.Column="2" Content="浏览" Click="OnBrowseTemp"/>
                        </Grid>
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="输出目录" Style="{StaticResource FieldLabel}"/>
                            <TextBox  Grid.Column="1" Text="{x:Bind Vm.OutputRoot, Mode=TwoWay}" IsReadOnly="True"/>
                            <Button   Grid.Column="2" Content="浏览" Click="OnBrowseOutput"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- 视频信息 + 处理选项 -->
                <Grid ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource CardBorder}">
                        <StackPanel Spacing="4">
                            <TextBlock Text="原视频信息 (自动检测)" Style="{StaticResource SectionTitle}"/>
                            <TextBlock Text="{x:Bind Vm.VideoInfoText, Mode=OneWay}" TextWrapping="Wrap" FontSize="12"/>
                            <TextBlock Text="输出分辨率" FontWeight="SemiBold" FontSize="12" Margin="0,4,0,0"/>
                            <TextBlock Text="{x:Bind Vm.OutputResolutionText, Mode=OneWay}" FontSize="12"/>
                            <TextBlock Text="目标帧率" FontWeight="SemiBold" FontSize="12" Margin="0,4,0,0"/>
                            <TextBlock Text="{x:Bind Vm.TargetFpsText, Mode=OneWay}" FontSize="12"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="1" Style="{StaticResource CardBorder}">
                        <StackPanel Spacing="4">
                            <TextBlock Text="处理选项" Style="{StaticResource SectionTitle}"/>
                            <CheckBox Content="拆分帧" IsChecked="{x:Bind Vm.SplitFrames, Mode=TwoWay}" FontSize="12"/>
                            <CheckBox Content="超分" IsChecked="{x:Bind Vm.SuperResolution, Mode=TwoWay}" FontSize="12"/>
                            <CheckBox Content="补帧" IsChecked="{x:Bind Vm.Interpolation, Mode=TwoWay}" FontSize="12"/>
                            <CheckBox Content="合并视频 (依赖拆分帧)" IsChecked="{x:Bind Vm.MergeVideo, Mode=TwoWay}" FontSize="12"/>
                            <CheckBox Content="SDR -> HDR 转换" IsChecked="{x:Bind Vm.SdrToHdr, Mode=TwoWay}" IsEnabled="{x:Bind Vm.IsHdrEnabled, Mode=OneWay}" FontSize="12"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- 超分 + 补帧设置 -->
                <Grid ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource CardBorder}">
                        <StackPanel Spacing="6">
                            <TextBlock Text="超分设置" Style="{StaticResource SectionTitle}"/>
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="50"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="模型" VerticalAlignment="Center" FontSize="12"/>
                                <ComboBox Grid.Column="1" ItemsSource="{x:Bind Vm.SrModels}" SelectedItem="{x:Bind Vm.SrModel, Mode=TwoWay}" MinWidth="200" HorizontalAlignment="Stretch" PlaceholderText="选择模型"/>
                            </Grid>
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="50"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="倍率" VerticalAlignment="Center" FontSize="12"/>
                                <ComboBox Grid.Column="1" SelectedItem="{x:Bind Vm.SrScale, Mode=TwoWay}" MinWidth="200" HorizontalAlignment="Stretch">
                                    <x:Int32>2</x:Int32>
                                    <x:Int32>3</x:Int32>
                                    <x:Int32>4</x:Int32>
                                </ComboBox>
                            </Grid>
                            <TextBlock Text="{x:Bind Vm.OutputResolutionText, Mode=OneWay}" Opacity="0.6" FontSize="11"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="1" Style="{StaticResource CardBorder}">
                        <StackPanel Spacing="6">
                            <TextBlock Text="补帧设置" Style="{StaticResource SectionTitle}"/>
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="50"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="模型" VerticalAlignment="Center" FontSize="12"/>
                                <ComboBox Grid.Column="1" ItemsSource="{x:Bind Vm.IfModels}" SelectedItem="{x:Bind Vm.IfModel, Mode=TwoWay}" MinWidth="200" HorizontalAlignment="Stretch" PlaceholderText="选择模型"/>
                            </Grid>
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="50"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="倍率" VerticalAlignment="Center" FontSize="12"/>
                                <ComboBox Grid.Column="1" SelectedItem="{x:Bind Vm.IfMultiplier, Mode=TwoWay}" MinWidth="200" HorizontalAlignment="Stretch">
                                    <x:Int32>2</x:Int32>
                                    <x:Int32>3</x:Int32>
                                    <x:Int32>4</x:Int32>
                                    <x:Int32>5</x:Int32>
                                </ComboBox>
                            </Grid>
                            <TextBlock Text="{x:Bind Vm.TargetFpsText, Mode=OneWay}" Opacity="0.6" FontSize="11"/>
                            <TextBlock Text="{x:Bind Vm.VramWarning, Mode=OneWay}" TextWrapping="Wrap" Foreground="Orange" FontSize="11"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- 音频 -->
                <Border Style="{StaticResource CardBorder}">
                    <StackPanel Spacing="6">
                        <TextBlock Text="音频设置" Style="{StaticResource SectionTitle}"/>
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Button   Grid.Column="0" Content="拆分音频" Click="OnExtractAudio" IsEnabled="{x:Bind Vm.CanStart, Mode=OneWay}"/>
                            <TextBlock Grid.Column="1" Text="{x:Bind Vm.ExtractedAudioPath, Mode=OneWay}" VerticalAlignment="Center" IsTextSelectionEnabled="True" Opacity="0.6" TextTrimming="CharacterEllipsis" FontSize="11"/>
                            <TextBlock Grid.Column="2" Text="FLAC -> PCM 24bit 96kHz" VerticalAlignment="Center" Opacity="0.6" FontSize="11"/>
                        </Grid>
                        <CheckBox Content="将原音频合并进新视频 (处理结束时自动提取并合并)" IsChecked="{x:Bind Vm.MergeAudio, Mode=TwoWay}" FontSize="12"/>
                    </StackPanel>
                </Border>

                <!-- HDR 参数 -->
                <Border Style="{StaticResource CardBorder}" Visibility="{x:Bind Vm.SdrToHdrVis, Mode=OneWay}">
                    <StackPanel Spacing="6">
                        <TextBlock Text="HDR 参数" Style="{StaticResource SectionTitle}"/>
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="饱和度" VerticalAlignment="Center" FontSize="12"/>
                            <TextBlock Grid.Column="1" Text="200 (固定)" VerticalAlignment="Center" FontSize="12" Opacity="0.7"/>
                            <TextBlock Grid.Column="2" Text="对比度" VerticalAlignment="Center" FontSize="12"/>
                            <TextBlock Grid.Column="3" Text="200 (固定)" VerticalAlignment="Center" FontSize="12" Opacity="0.7"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- 警告/提示 -->
                <Border Style="{StaticResource CardBorder}" BorderBrush="Orange" Background="{ThemeResource WarnBgBrush}">
                    <StackPanel Spacing="2">
                        <TextBlock Text="高级性能选项" Style="{StaticResource SectionTitle}"/>
                        <CheckBox Content="开启安全帧率 (自动降级)" IsChecked="{x:Bind Vm.UseSafeFrameRate, Mode=TwoWay}" FontSize="12"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardBorder}" BorderBrush="Orange" Background="{ThemeResource WarnBgBrush}">
                    <StackPanel Spacing="2">
                        <TextBlock Text="警告 / 提示" Style="{StaticResource SectionTitle}"/>
                        <TextBlock Text="{x:Bind Vm.Warnings, Mode=OneWay}" TextWrapping="Wrap" FontFamily="Consolas" FontSize="11"/>
                    </StackPanel>
                </Border>

                <!-- 按钮（进度与日志已移至"进行中"页） -->
                <Border Style="{StaticResource CardBorder}">
                    <StackPanel Spacing="8">
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Content="开始处理 (Ctrl+S)" Click="OnStart" IsEnabled="{x:Bind Vm.CanStart, Mode=OneWay}" Style="{StaticResource AccentButtonStyle}"/>
                            <Button Grid.Column="1" Content="停止 (Ctrl+Shift+S)" Click="OnStop" IsEnabled="{x:Bind Vm.CanStop, Mode=OneWay}"/>
                            <Button Grid.Column="2" Content="清理临时文件" Click="OnCleanTemp"/>
                        </Grid>
                        <TextBlock Text="{x:Bind Vm.FinalOutputName, Mode=OneWay}" Opacity="0.6" FontSize="11" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>


